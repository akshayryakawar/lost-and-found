<%- include('../../partials/head', { title: 'My Dashboard | Campus Lost & Found' }) %>
<%- include('../../partials/navbar', { activePage: 'dashboard' }) %>

<main class="py-4">
  <div class="container">
    <%- include('../../partials/alerts') %>

    <!-- Student Profile & Dashboard Banner -->
    <div class="p-4 bg-card-dark rounded-4 border shadow-sm mb-4">
      <div class="row align-items-center g-3">
        <div class="col-md-7">
          <div class="d-flex align-items-center gap-3">
            <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fs-3 fw-bold" style="width: 56px; height: 56px;">
              <%= currentUser.name.charAt(0).toUpperCase() %>
            </div>
            <div>
              <h1 class="h3 fw-bold mb-0"><%= currentUser.name %></h1>
              <div class="text-muted small">
                <i class="bi bi-envelope me-1"></i> <%= currentUser.email %> 
                <span class="badge bg-primary-subtle text-primary ms-2"><%= currentUser.role === 'admin' ? 'Campus Admin' : 'Registered Student' %></span>
              </div>
            </div>
          </div>
        </div>

        <div class="col-md-5 text-md-end">
          <a href="/items/report" class="btn btn-primary rounded-pill px-4 fw-semibold shadow-sm">
            <i class="bi bi-plus-circle me-1"></i> Report New Item
          </a>
        </div>
      </div>
    </div>

    <!-- Metric Stats Row -->
    <div class="row g-3 mb-4">
      <div class="col-md-4">
        <div class="dashboard-stat-card">
          <div class="stat-icon-wrap stat-icon-blue">
            <i class="bi bi-file-earmark-text"></i>
          </div>
          <div>
            <div class="text-muted small fw-semibold">My Reports</div>
            <h3 class="fw-bold mb-0"><%= myReports.length %></h3>
          </div>
        </div>
      </div>

      <div class="col-md-4">
        <div class="dashboard-stat-card">
          <div class="stat-icon-wrap stat-icon-amber">
            <i class="bi bi-shield-check"></i>
          </div>
          <div>
            <div class="text-muted small fw-semibold">My Claims</div>
            <h3 class="fw-bold mb-0"><%= myClaims.length %></h3>
          </div>
        </div>
      </div>

      <div class="col-md-4">
        <div class="dashboard-stat-card">
          <div class="stat-icon-wrap stat-icon-green">
            <i class="bi bi-check2-circle"></i>
          </div>
          <div>
            <div class="text-muted small fw-semibold">Reunited Items</div>
            <h3 class="fw-bold mb-0">
              <%= myReports.filter(r => r.status === 'returned').length + myClaims.filter(c => c.status === 'approved').length %>
            </h3>
          </div>
        </div>
      </div>
    </div>

    <!-- Tabs: Reports vs Claims -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
      <div class="card-header bg-card-dark border-bottom p-0">
        <ul class="nav nav-tabs border-0 px-3 pt-2" id="dashboardTab" role="tablist">
          <li class="nav-item" role="presentation">
            <button class="nav-link active fw-bold py-3 px-4 border-0 border-bottom border-primary border-3" id="reports-tab" data-bs-toggle="tab" data-bs-target="#reports-pane" type="button" role="tab" aria-controls="reports-pane" aria-selected="true">
              <i class="bi bi-folder2-open me-2 text-primary"></i> My Reported Items (<%= myReports.length %>)
            </button>
          </li>
          <li class="nav-item" role="presentation">
            <button class="nav-link fw-bold py-3 px-4 border-0" id="claims-tab" data-bs-toggle="tab" data-bs-target="#claims-pane" type="button" role="tab" aria-controls="claims-pane" aria-selected="false">
              <i class="bi bi-patch-check me-2 text-success"></i> My Claims (<%= myClaims.length %>)
            </button>
          </li>
        </ul>
      </div>

      <div class="card-body p-4">
        <div class="tab-content" id="dashboardTabContent">
          <!-- Tab 1: My Reports -->
          <div class="tab-pane fade show active" id="reports-pane" role="tabpanel" aria-labelledby="reports-tab">
            <% if (myReports && myReports.length > 0) { %>
              <div class="table-responsive">
                <table class="table table-custom align-middle">
                  <thead>
                    <tr>
                      <th>Item Details</th>
                      <th>Type</th>
                      <th>Location</th>
                      <th>Date</th>
                      <th>Status</th>
                      <th class="text-end">Actions</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% myReports.forEach(report => { %>
                      <tr>
                        <td>
                          <div class="d-flex align-items-center gap-3">
                            <% if (report.imageUrl) { %>
                              <img src="<%= report.imageUrl %>" class="rounded-3" style="width: 48px; height: 48px; object-fit: cover;" alt="">
                            <% } else { %>
                              <div class="rounded-3 bg-dark-alt d-flex align-items-center justify-content-center text-muted" style="width: 48px; height: 48px;">
                                <i class="bi bi-box"></i>
                              </div>
                            <% } %>
                            <div>
                              <a href="/items/<%= report._id %>" class="fw-bold text-white text-decoration-none">
                                <%= report.title %>
                              </a>
                              <div class="small text-muted"><%= report.category.replace('_', ' ') %></div>
                            </div>
                          </div>
                        </td>
                        <td>
                          <span class="badge <%= report.type === 'lost' ? 'bg-danger-subtle text-danger' : 'bg-success-subtle text-success' %> px-2 py-1">
                            <%= report.type.toUpperCase() %>
                          </span>
                        </td>
                        <td>
                          <div class="small"><i class="bi bi-geo-alt text-danger me-1"></i><%= report.location %></div>
                        </td>
                        <td>
                          <div class="small text-muted"><%= new Date(report.dateLostOrFound).toLocaleDateString() %></div>
                        </td>
                        <td>
                          <span class="badge badge-status status-<%= report.status %>">
                            <%= report.status.replace('_', ' ').toUpperCase() %>
                          </span>
                        </td>
                        <td class="text-end">
                          <a href="/items/<%= report._id %>" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                            View <i class="bi bi-arrow-right"></i>
                          </a>
                        </td>
                      </tr>
                    <% }); %>
                  </tbody>
                </table>
              </div>
            <% } else { %>
              <div class="text-center py-5">
                <i class="bi bi-inbox display-4 text-muted mb-3 d-block"></i>
                <h5 class="fw-bold text-white">No reports logged yet</h5>
                <p class="text-muted small">Have you lost or found something on campus?</p>
                <a href="/items/report" class="btn btn-primary rounded-pill px-4">Submit a Report</a>
              </div>
            <% } %>
          </div>

          <!-- Tab 2: My Claims -->
          <div class="tab-pane fade" id="claims-pane" role="tabpanel" aria-labelledby="claims-tab">
            <% if (myClaims && myClaims.length > 0) { %>
              <div class="table-responsive">
                <table class="table table-custom align-middle">
                  <thead>
                    <tr>
                      <th>Target Item</th>
                      <th>Proof Submitted</th>
                      <th>Claim Date</th>
                      <th>Status</th>
                      <th>Next Step</th>
                      <th class="text-end">Action</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% myClaims.forEach(claim => { %>
                      <tr>
                        <td>
                          <div class="fw-bold text-white"><%= claim.item ? claim.item.title : 'Item #' + claim.itemId %></div>
                          <small class="text-muted">Item ID: <%= claim.itemId %></small>
                        </td>
                        <td>
                          <div class="text-truncate small text-secondary" style="max-width: 260px;" title="<%= claim.proofDescription %>">
                            <%= claim.proofDescription %>
                          </div>
                        </td>
                        <td>
                          <div class="small text-muted"><%= new Date(claim.createdAt).toLocaleDateString() %></div>
                        </td>
                        <td>
                          <% if (claim.status === 'pending') { %>
                            <span class="badge bg-warning-subtle text-warning border px-2 py-1">
                              <i class="bi bi-hourglass-split me-1"></i> Under Review
                            </span>
                          <% } else if (claim.status === 'approved') { %>
                            <span class="badge bg-success-subtle text-success border px-2 py-1">
                              <i class="bi bi-check-circle-fill me-1"></i> Approved
                            </span>
                          <% } else { %>
                            <span class="badge bg-danger-subtle text-danger border px-2 py-1">
                              <i class="bi bi-x-circle me-1"></i> Rejected
                            </span>
                          <% } %>
                        </td>
                        <td>
                          <% if (claim.status === 'approved') { %>
                            <span class="small text-success fw-semibold">
                              <i class="bi bi-building"></i> Collect at Student Center Room 102
                            </span>
                          <% } else if (claim.status === 'pending') { %>
                            <span class="small text-muted">Awaiting security staff verification</span>
                          <% } else { %>
                            <span class="small text-danger">Proof insufficient. Contact desk.</span>
                          <% } %>
                        </td>
                        <td class="text-end">
                          <a href="/items/<%= claim.itemId %>" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
                            View Item
                          </a>
                        </td>
                      </tr>
                    <% }); %>
                  </tbody>
                </table>
              </div>
            <% } else { %>
              <div class="text-center py-5">
                <i class="bi bi-shield-x display-4 text-muted mb-3 d-block"></i>
                <h5 class="fw-bold text-white">No claims filed yet</h5>
                <p class="text-muted small">Browse found items to claim something that belongs to you.</p>
                <a href="/items?type=found" class="btn btn-outline-success rounded-pill px-4">Browse Found Items</a>
              </div>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </div>
</main>

<%- include('../../partials/footer') %>
