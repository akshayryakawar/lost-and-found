<%- include('../../partials/head', { title: '500 - Server Error | Campus Lost & Found' }) %>
<%- include('../../partials/navbar', { activePage: '' }) %>

<main class="py-5">
  <div class="container text-center py-5" style="max-width: 600px;">
    <div class="mb-4">
      <div class="rounded-circle bg-warning-subtle text-warning d-inline-flex align-items-center justify-content-center" style="width: 88px; height: 88px; font-size: 2.75rem;">
        <i class="bi bi-exclamation-triangle"></i>
      </div>
    </div>

    <h1 class="display-5 fw-bold text-white mb-2">Unexpected Glitch</h1>
    <h2 class="h5 text-muted mb-4">500 - Internal Server Error</h2>

    <p class="text-secondary mb-4">
      Our campus server encountered an issue processing your request. Please try again in a few moments, or reach out to the campus helpdesk.
    </p>

    <div class="d-flex justify-content-center gap-3">
      <a href="/" class="btn btn-primary rounded-pill px-4 fw-semibold">
        <i class="bi bi-house-door me-1"></i> Return Home
      </a>
      <button onclick="window.location.reload()" class="btn btn-outline-secondary rounded-pill px-4">
        <i class="bi bi-arrow-clockwise me-1"></i> Try Again
      </button>
    </div>
  </div>
</main>

<%- include('../../partials/footer') %>
