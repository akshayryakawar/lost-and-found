<%- include('../../partials/head', { title: '500 - Server Error | Campus Lost & Found' }) %>
<%- include('../../partials/navbar', { activePage: '' }) %>

<main class="py-5 position-relative">
  <!-- Subtle ambient glow -->
  <div class="ambient-glow-wrapper">
    <div class="ambient-glow-center" style="width: 500px; height: 500px;"></div>
  </div>

  <div class="container text-center py-5 position-relative" style="max-width: 620px; z-index: 5;">
    <div class="mb-4">
      <span class="asterisk-mark" style="font-size: 3.5rem; color: var(--lost-color);">&#10033;</span>
    </div>

    <h1 class="display-4 fw-bold text-white mb-2" style="letter-spacing: -0.04em;">System Glitch</h1>
    <h2 class="h5 text-muted mb-4">500 &mdash; An unexpected server error occurred while processing your request.</h2>

    <p class="text-muted mb-4" style="line-height: 1.7;">
      Our systems team has been notified. Please try returning to the home directory or report the issue to campus security dispatch.
    </p>

    <div class="d-flex justify-content-center gap-3">
      <a href="/" class="btn-pill-white">
        <span>Return to Homepage</span>
        <span class="arrow-chip">&rarr;</span>
      </a>
      <a href="/items" class="btn-pill-ghost">
        <span>Browse Catalog</span>
      </a>
    </div>
  </div>
</main>

<%- include('../../partials/footer') %>
