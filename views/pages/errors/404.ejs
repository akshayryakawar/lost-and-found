<%- include('../../partials/head', { title: '404 - Page Not Found | Campus Lost & Found' }) %>
<%- include('../../partials/navbar', { activePage: '' }) %>

<main class="py-5">
  <div class="container text-center py-5" style="max-width: 600px;">
    <div class="mb-4">
      <div class="rounded-circle bg-danger-subtle text-danger d-inline-flex align-items-center justify-content-center" style="width: 88px; height: 88px; font-size: 2.75rem;">
        <i class="bi bi-compass"></i>
      </div>
    </div>

