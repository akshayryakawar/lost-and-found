<%- include('../../partials/head', { title: 'Set New Password | Campus Lost & Found' }) %>
<%- include('../../partials/navbar', { activePage: 'login' }) %>

<main class="py-5 position-relative">
  <!-- Ambient glow blobs behind the centered card -->
  <div class="ambient-glow-wrapper">
    <div class="ambient-glow-top"></div>
    <div class="ambient-glow-center" style="width: 520px; height: 520px; opacity: 0.9;"></div>
  </div>

  <div class="container position-relative" style="max-width: 480px; z-index: 5;">
    <%- include('../../partials/alerts') %>

    <!-- Standard Page Header -->
    <div class="page-header text-center mb-4">
      <div class="page-eyebrow">
        <span class="eyebrow-icon">&#9679;</span>
        <span>Credential Security</span>
      </div>
      <h1 class="page-title">
        New <span class="hero-accent-serif">Password.</span>
      </h1>
      <p class="page-subtitle">
        Create a new secure password (minimum 8 characters) for your campus account.
      </p>
    </div>

    <!-- Centered Glass Card -->
    <div class="glass-panel p-4 p-md-5">
      <form action="/auth/reset-password" method="POST" id="resetPasswordForm">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="token" value="<%= typeof token !== 'undefined' ? token : '' %>">

        <div class="mb-3">
          <label for="newPassword" class="form-label text-white">New Password</label>
          <div class="input-group">
            <span class="input-group-text border-end-0 text-muted"><i class="bi bi-lock"></i></span>
            <input type="password" class="form-control border-start-0 ps-0" id="newPassword" name="password" placeholder="••••••••" required minlength="8" autofocus>
          </div>
          <div class="form-text small text-muted">Must be at least 8 characters long.</div>
        </div>

        <div class="mb-4">
          <label for="confirmPassword" class="form-label text-white">Confirm New Password</label>
          <div class="input-group">
            <span class="input-group-text border-end-0 text-muted"><i class="bi bi-shield-lock"></i></span>
            <input type="password" class="form-control border-start-0 ps-0" id="confirmPassword" name="confirmPassword" placeholder="••••••••" required minlength="8">
          </div>
        </div>

        <button type="submit" class="btn-pill-white w-100 justify-content-center py-2 mb-3">
          <span>Update Password</span>
          <span class="arrow-chip">&nearr;</span>
        </button>

        <div class="text-center small text-muted">
          <a href="/auth/login" class="fw-bold text-white text-decoration-none">Back to Login</a>
        </div>
      </form>
    </div>
  </div>
</main>

<%- include('../../partials/footer') %>
