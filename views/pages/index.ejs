<%- include('../partials/head', { title: 'Campus Lost & Found | Official University Portal' }) %>
<%- include('../partials/navbar', { activePage: 'home' }) %>

<main>
  <!-- ====================================================
       HERO SECTION
       ==================================================== -->
  <section class="hero-section">
    <div class="container position-relative">
      <div class="row align-items-center gy-5">
        <div class="col-lg-7">

          <!-- Early-access pill badge -->
          <div class="hero-pill mb-4">
            <span style="width:8px;height:8px;background:#fbbf24;border-radius:50%;display:inline-block;"></span>
            Official Campus Recovery Network &mdash; Now Live
          </div>

          <!-- Floating avatar badges above title -->
          <div class="hero-avatar-badges mb-3">
            <span class="avatar-badge avatar-badge-teal">
              <span class="avatar-badge-icon">A</span>
              Alex recovered his AirPods
            </span>
            <span class="avatar-badge avatar-badge-pink">
              <span class="avatar-badge-icon">R</span>
              Riya found her Student ID
            </span>
            <span class="avatar-badge avatar-badge-purple">
              <span class="avatar-badge-icon">K</span>
              Karan got his wallet back
            </span>
          </div>

          <!-- Big hero title -->
          <h1 class="hero-title">
            Lost something<br>on campus?
            <span class="hero-title-accent">Let&rsquo;s get it back.</span>
          </h1>

          <p class="hero-subtitle mt-3">
            The official central registry for lost and found belongings across all faculties, libraries, student halls, and athletic facilities.
          </p>

          <!-- Quick action buttons -->
          <div class="d-flex flex-wrap gap-3 mb-4">
            <a href="/items/report?type=lost" class="btn btn-danger btn-lg px-4 rounded-pill d-flex align-items-center gap-2">
              <i class="bi bi-search"></i>
              <span>Report Lost Item</span>
            </a>
            <a href="/items/report?type=found" class="btn btn-success btn-lg px-4 rounded-pill d-flex align-items-center gap-2">
              <i class="bi bi-plus-circle"></i>
              <span>Report Found Item</span>
            </a>
            <a href="/items" class="btn btn-outline-dark btn-lg px-4 rounded-pill">
              Browse All Items
            </a>
          </div>

          <!-- Hero search card -->
          <div class="hero-search-card">
            <form action="/items" method="GET" class="row g-2 align-items-center">
              <div class="col-md-5">
                <div class="input-group">
                  <span class="input-group-text bg-transparent border-0" style="color:rgba(255,255,255,.35);"><i class="bi bi-search"></i></span>
                  <input type="text" name="search" class="form-control border-0 shadow-none ps-0" placeholder="Search keywords (e.g. AirPods, keys, wallet)..." style="background:transparent;color:#fff;">
                </div>
              </div>
              <div class="col-md-3">
                <select name="type" class="form-select border-0 shadow-none" style="background:transparent;color:rgba(255,255,255,.7);">
                  <option value="" style="background:#1f1f1f;">All Types</option>
                  <option value="lost" style="background:#1f1f1f;">Lost Items</option>
                  <option value="found" style="background:#1f1f1f;">Found Items</option>
                </select>
              </div>
              <div class="col-md-4">
                <button type="submit" class="btn btn-primary w-100 rounded-pill fw-semibold py-2">
                  <i class="bi bi-arrow-right-circle me-1"></i> Search
                </button>
              </div>
            </form>
          </div>

          <!-- Stats strip -->
          <div class="hero-stats-banner">
            <div class="stat-item">
              <h3><%= stats.totalItems %>+</h3>
              <p>Items Logged</p>
            </div>
            <div class="stat-item">
              <h3><%= stats.returnedItems %></h3>
              <p>Reunited Owners</p>
            </div>
            <div class="stat-item">
              <h3><%= stats.activeClaims %></h3>
              <p>Active Inquiries</p>
            </div>
            <div class="stat-item">
              <h3>94%</h3>
              <p>Resolution Rate</p>
            </div>
          </div>
        </div>

        <!-- Right: dark live activity card -->
        <div class="col-lg-5 d-none d-lg-block">
          <div class="hero-live-card">
            <div class="hero-live-card-header">
              <span class="fw-bold" style="color:#fff;font-size:.9rem;">
                <i class="bi bi-activity me-2" style="color:#2dd4bf;"></i>Live Campus Activity
              </span>
              <span class="d-flex align-items-center gap-1" style="font-size:.75rem;font-weight:700;color:#34d399;">
                <span style="width:7px;height:7px;border-radius:50%;background:#34d399;animation:pulse 2s infinite;"></span>
                Real-time
              </span>
            </div>

            <div class="live-feed-item lost">
              <div class="d-flex justify-content-between align-items-center mb-1">
                <span class="badge rounded-pill" style="background:rgba(248,113,113,.15);color:#f87171;font-size:.68rem;border:1px solid rgba(248,113,113,.25);">LOST</span>
                <small>12 mins ago</small>
              </div>
              <div class="fw-bold">Black Sony WH-1000XM4 Headphones</div>
              <small><i class="bi bi-geo-alt me-1"></i>Science Library, 3rd Floor</small>
            </div>

            <div class="live-feed-item found">
              <div class="d-flex justify-content-between align-items-center mb-1">
                <span class="badge rounded-pill" style="background:rgba(52,211,153,.15);color:#34d399;font-size:.68rem;border:1px solid rgba(52,211,153,.25);">FOUND</span>
                <small>45 mins ago</small>
              </div>
              <div class="fw-bold">Student ID Card — Engineering Dept.</div>
              <small><i class="bi bi-geo-alt me-1"></i>Dining Hall Tray Return</small>
            </div>

            <div class="live-feed-item returned">
              <div class="d-flex justify-content-between align-items-center mb-1">
                <span class="badge rounded-pill" style="background:rgba(59,130,246,.15);color:#3b82f6;font-size:.68rem;border:1px solid rgba(59,130,246,.25);">REUNITED</span>
                <small>2 hours ago</small>
              </div>
              <div class="fw-bold">Hydro Flask Water Bottle (Teal)</div>
              <small><i class="bi bi-check-circle me-1" style="color:#34d399;"></i>Handed over at Security Dispatch</small>
            </div>

            <div class="live-feed-item lost">
              <div class="d-flex justify-content-between align-items-center mb-1">
                <span class="badge rounded-pill" style="background:rgba(248,113,113,.15);color:#f87171;font-size:.68rem;border:1px solid rgba(248,113,113,.25);">LOST</span>
                <small>3 hours ago</small>
              </div>
              <div class="fw-bold">MacBook Pro Charger (MagSafe)</div>
              <small><i class="bi bi-geo-alt me-1"></i>Main Library Study Pods</small>
            </div>

            <div class="mt-3 pt-3 text-center" style="border-top:1px solid rgba(255,255,255,.07);">
              <a href="/items" class="small fw-semibold" style="color:#2dd4bf;text-decoration:none;">
                Explore all verified items <i class="bi bi-arrow-right ms-1"></i>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ====================================================
       CATEGORIES SECTION
       ==================================================== -->
  <section class="py-5 section-dark-alt">
    <div class="container">
      <div class="d-flex justify-content-between align-items-end mb-4">
        <div>
          <p class="section-label mb-1">Quick Browse</p>
          <h2 class="fs-3 fw-bold mb-1" style="color:#fff;">Browse by Category</h2>
          <p class="small mb-0" style="color:rgba(255,255,255,.4);">Jump straight to what you&rsquo;re looking for</p>
        </div>
        <a href="/items" class="btn btn-outline-dark btn-sm rounded-pill fw-semibold">
          View All <i class="bi bi-arrow-right ms-1"></i>
        </a>
      </div>

      <div class="row g-3">
        <% const categoriesList = [
          { key: 'electronics',    name: 'Electronics',         icon: 'bi-laptop',        count: 18 },
          { key: 'id_cards',       name: 'Student IDs & Cards', icon: 'bi-person-badge',  count: 24 },
          { key: 'keys_wallets',   name: 'Keys & Wallets',      icon: 'bi-key',           count: 15 },
          { key: 'bags_backpacks', name: 'Bags & Backpacks',    icon: 'bi-backpack',      count: 9 },
          { key: 'books_notes',    name: 'Books & Notes',       icon: 'bi-book',          count: 12 },
          { key: 'clothing',       name: 'Clothing & Accessories', icon: 'bi-sunglasses', count: 8 }
        ]; %>

        <% categoriesList.forEach(cat => { %>
          <div class="col-6 col-md-4 col-lg-2">
            <a href="/items?category=<%= cat.key %>" class="category-card">
              <div class="category-icon">
                <i class="bi <%= cat.icon %>"></i>
              </div>
              <div class="category-name"><%= cat.name %></div>
              <div class="category-count"><%= cat.count %> items listed</div>
            </a>
          </div>
        <% }); %>
      </div>
    </div>
  </section>

  <!-- ====================================================
       RECENT ITEMS
       ==================================================== -->
  <section class="py-5">
    <div class="container">
      <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
          <p class="section-label mb-1">Recently Added</p>
          <h2 class="fs-3 fw-bold mb-1" style="color:#fff;">Latest Lost &amp; Found Reports</h2>
          <p class="small mb-0" style="color:rgba(255,255,255,.4);">Review recent entries or search using the filters above</p>
        </div>
        <div class="d-flex gap-2">
          <a href="/items?type=lost" class="btn btn-outline-danger btn-sm rounded-pill px-3">
            <i class="bi bi-search me-1"></i> Lost (<%= stats.lostCount %>)
          </a>
          <a href="/items?type=found" class="btn btn-outline-success btn-sm rounded-pill px-3">
            <i class="bi bi-check-circle me-1"></i> Found (<%= stats.foundCount %>)
          </a>
        </div>
      </div>

      <div class="row g-3">
        <% if (recentItems && recentItems.length > 0) { %>
          <% recentItems.forEach(item => { %>
            <%- include('../partials/item-card', { item: item }) %>
          <% }); %>
        <% } else { %>
          <div class="col-12">
            <div class="empty-state-box">
              <div class="empty-state-icon"><i class="bi bi-inbox"></i></div>
              <h4 style="color:#fff;">No items reported recently</h4>
              <p style="color:rgba(255,255,255,.4);">Be the first to submit a report if you lost or found something on campus.</p>
              <a href="/items/report" class="btn btn-primary rounded-pill px-4 mt-2">Submit Report</a>
            </div>
          </div>
        <% } %>
      </div>

      <div class="text-center mt-5">
        <a href="/items" class="btn btn-outline-dark px-5 py-2 rounded-pill fw-semibold">
          Browse All <%= stats.totalItems %> Items <i class="bi bi-arrow-right ms-2"></i>
        </a>
      </div>
    </div>
  </section>

  <!-- ====================================================
       HOW IT WORKS
       ==================================================== -->
  <section class="py-5 section-dark-alt" id="howItWorks">
    <div class="container">
      <div class="text-center mb-5">
        <p class="section-label">Simple &amp; Secure</p>
        <h2 class="fs-3 fw-bold mb-2" style="color:#fff;">How Campus Recovery Works</h2>
        <p style="color:rgba(255,255,255,.45);max-width:500px;margin:0 auto;">Follow these 3 simple steps to find, claim, or return lost property on campus.</p>
      </div>

      <div class="row g-4">
        <div class="col-md-4">
          <div class="how-step-card">
            <div class="how-step-number">1</div>
            <h4 class="fs-5 fw-bold mb-2" style="color:#fff;">Report or Search</h4>
            <p class="small mb-0" style="color:rgba(255,255,255,.45);">
              Lost an item? Submit a detailed description and photo. Found something? Log it to notify potential owners across campus immediately.
            </p>
          </div>
        </div>
        <div class="col-md-4">
          <div class="how-step-card">
            <div class="how-step-number">2</div>
            <h4 class="fs-5 fw-bold mb-2" style="color:#fff;">Verify &amp; Claim</h4>
            <p class="small mb-0" style="color:rgba(255,255,255,.45);">
              Submit proof of ownership — unique markings, serial numbers, or lock-screen details — to prevent unauthorized pickups.
            </p>
          </div>
        </div>
        <div class="col-md-4">
          <div class="how-step-card">
            <div class="how-step-number">3</div>
            <h4 class="fs-5 fw-bold mb-2" style="color:#fff;">Collect Safely</h4>
            <p class="small mb-0" style="color:rgba(255,255,255,.45);">
              Once approved by campus security, collect your item at the Student Center Security Dispatch Desk with your student ID.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ====================================================
       CTA BANNER
       ==================================================== -->
  <section class="py-5">
    <div class="container">
      <div class="cta-banner">
        <div class="row align-items-center">
          <div class="col-lg-8">
            <span class="badge rounded-pill fw-bold mb-3" style="background:rgba(45,212,191,.15);color:#2dd4bf;border:1px solid rgba(45,212,191,.25);padding:.4rem .9rem;">Official Campus Custody</span>
            <h2 class="fw-bold fs-3 mb-2" style="color:#fff;">Physical Drop-Off &amp; Retrieval Location</h2>
            <p class="mb-4" style="color:rgba(255,255,255,.45);">
              All high-value items (wallets, laptops, phones, government IDs) handed to campus staff are securely held in the Central Security Vault at the Student Center.
            </p>
            <div class="d-flex flex-wrap gap-4 small" style="color:rgba(255,255,255,.4);">
              <div><i class="bi bi-geo-alt-fill me-2" style="color:#fbbf24;"></i>Student Center, Ground Floor, Room 102</div>
              <div><i class="bi bi-clock-fill me-2" style="color:#fbbf24;"></i>Mon–Fri &nbsp;8:00 AM – 6:00 PM</div>
              <div><i class="bi bi-shield-check me-2" style="color:#fbbf24;"></i>Student ID verification required</div>
            </div>
          </div>
          <div class="col-lg-4 text-lg-end mt-4 mt-lg-0">
            <a href="/items/report?type=found" class="btn btn-lg px-5 rounded-pill fw-bold" style="background:#fff;color:#0a0a0a;box-shadow:0 4px 20px rgba(255,255,255,.12);">
              Hand In an Item
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</main>

<!-- Pulse animation for real-time dot -->
<style>
@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.3; }
}
</style>

<%- include('../partials/claim-modal') %>
<%- include('../partials/footer') %>
