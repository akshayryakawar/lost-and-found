<%- include('../../partials/head', { title: 'Notifications | Campus Lost & Found' }) %>
<%- include('../../partials/navbar', { activePage: 'notifications' }) %>

<main class="py-4">
  <div class="container" style="max-width: 760px;">
    <%- include('../../partials/alerts') %>

    <div class="d-flex justify-content-between align-items-center mb-4">
      <div>
        <h1 class="h3 fw-bold text-white mb-1">Campus Alerts &amp; Notifications</h1>
        <p class="text-muted small mb-0">Stay informed about your reports and submitted claims</p>
      </div>
      <% if (notifications && notifications.length > 0) { %>
        <form action="/notifications/mark-read" method="POST">
          <button type="submit" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
            <i class="bi bi-check2-all me-1"></i> Mark All as Read
          </button>
        </form>
      <% } %>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
      <div class="list-group list-group-flush">
        <% if (notifications && notifications.length > 0) { %>
          <% notifications.forEach(notif => { %>
            <div class="list-group-item p-3 d-flex align-items-start gap-3 <%= notif.isRead ? 'bg-card-dark' : 'bg-primary-subtle bg-opacity-25' %> border-bottom">
              <div class="rounded-circle p-2 mt-1 d-flex align-items-center justify-content-center <%= notif.isRead ? 'bg-dark-alt text-secondary' : 'bg-primary text-white' %>" style="width: 36px; height: 36px;">
                <i class="bi <%= notif.type === 'claim_status' ? 'bi-patch-check' : (notif.type === 'item_status' ? 'bi-box-seam' : 'bi-bell') %>"></i>
              </div>

              <div class="flex-grow-1">
                <div class="d-flex justify-content-between align-items-center mb-1">
                  <span class="badge <%= notif.isRead ? 'bg-secondary-subtle text-secondary' : 'bg-primary text-white' %> rounded-pill small">
                    <%= notif.type.replace('_', ' ').toUpperCase() %>
                  </span>
                  <small class="text-muted"><%= new Date(notif.createdAt).toLocaleDateString() %></small>
                </div>
                <p class="mb-1 text-white fw-medium fs-6"><%= notif.message %></p>
              </div>

              <% if (!notif.isRead) { %>
                <span class="p-1 bg-primary border border-light rounded-circle align-self-center" title="Unread"></span>
              <% } %>
            </div>
          <% }); %>
        <% } else { %>
          <div class="p-5 text-center">
            <i class="bi bi-bell-slash display-4 text-muted mb-3 d-block"></i>
            <h5 class="fw-bold text-white">No notifications yet</h5>
            <p class="text-muted small">You will receive alerts when security updates your reports or responds to your claims.</p>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</main>

<%- include('../../partials/footer') %>
