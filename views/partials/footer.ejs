<footer class="footer-campus">
  <div class="container">
    <div class="row g-4 mb-4">
      <!-- Col 1: About Portal -->
      <div class="col-lg-4 col-md-6">
        <div class="d-flex align-items-center gap-2 mb-3">
          <span class="asterisk-mark" style="font-size: 1.4rem;">&#10033;</span>
          <span class="text-white fw-bold fs-5">Campus Lost &amp; Found</span>
        </div>
        <p class="small text-muted mb-3" style="max-width: 320px; line-height: 1.6;">
          The official centralized campus recovery network. Connecting students, faculty, and security to safely reunite lost belongings.
        </p>
        <div>
          <span class="badge rounded-pill px-3 py-2 small" style="background: rgba(255,255,255,0.06); color: var(--accent-lime); border: 1px solid rgba(255,255,255,0.1);">
            <i class="bi bi-shield-lock-fill me-1"></i> Verified University Network
          </span>
        </div>
      </div>

      <!-- Col 2: Quick Links -->
      <div class="col-lg-2 col-md-6 col-6">
        <h5>Quick Links</h5>
        <ul class="footer-links">
          <li><a href="/">Home</a></li>
          <li><a href="/items">Browse All</a></li>
          <li><a href="/items?type=lost">Lost Items</a></li>
          <li><a href="/items?type=found">Found Items</a></li>
          <li><a href="/dashboard">My Dashboard</a></li>
        </ul>
      </div>

      <!-- Col 3: Report & Support -->
      <div class="col-lg-3 col-md-6 col-6">
        <h5>Reporting &amp; Help</h5>
        <ul class="footer-links">
          <li><a href="/items/report?type=lost">Report Lost Property</a></li>
          <li><a href="/items/report?type=found">Report Found Item</a></li>
          <li><a href="/#howItWorks">How Claiming Works</a></li>
          <li><a href="/auth/login">Student Login</a></li>
          <% if (currentUser && currentUser.role === 'admin') { %>
            <li><a href="/admin">Security Console</a></li>
          <% } %>
        </ul>
      </div>

      <!-- Col 4: Physical Recovery Desk -->
      <div class="col-lg-3 col-md-6">
        <h5>Physical Desk Info</h5>
        <p class="small text-muted mb-2">
          <i class="bi bi-geo-alt-fill me-2" style="color: var(--accent-pink);"></i>
          <strong class="text-white">Security Dispatch</strong><br>
          Student Center, Room 102
        </p>
        <p class="small text-muted mb-2">
          <i class="bi bi-clock-fill me-2" style="color: var(--accent-cyan);"></i>
          <strong class="text-white">Hours:</strong> Mon&ndash;Fri 8:00 AM &ndash; 6:00 PM
        </p>
        <p class="small text-muted mb-0">
          <i class="bi bi-telephone-fill me-2" style="color: var(--accent-lime);"></i>
          <strong class="text-white">Dispatch Desk:</strong> (555) 019-2834
        </p>
      </div>
    </div>

    <!-- Bottom Copyright -->
    <div class="footer-bottom d-flex flex-column flex-md-row justify-content-between align-items-center gap-2">
      <div>
        &copy; 2026 Campus Lost &amp; Found Portal. Built for university student communities.
      </div>
      <div class="d-flex gap-3 small text-muted">
        <a href="#">Privacy Protocol</a>
        <span>&bull;</span>
        <a href="#">Honor Code</a>
        <span>&bull;</span>
        <a href="#">Campus Guidelines</a>
      </div>
    </div>
  </div>
</footer>

<!-- Toast Container for Notifications -->
<div id="toastContainer" class="toast-container-campus" aria-live="polite" aria-atomic="true"></div>

<!-- Bootstrap 5.3.3 JS Bundle -->
<script src="/vendor/bootstrap/bootstrap.bundle.min.js"></script>

<!-- Custom App Script -->
<script src="/js/main.js?v=<%= assetVersion %>"></script>
</body>
</html>
