<%- include('../../partials/head', { title: '404 - Page Not Found | Campus Lost & Found' }) %>
<%- include('../../partials/navbar', { activePage: '' }) %>

<main class="py-5 position-relative overflow-hidden" style="min-height: 75vh; display: flex; align-items: center;">
  <!-- Ambient glow and texture -->
  <div class="ambient-glow-wrapper">
    <div class="ambient-glow-top"></div>
    <div class="ambient-glow-center" style="width: 550px; height: 550px;"></div>
  </div>

  <!-- Floating Cursor Chips like Hero -->
  <div class="hero-floating-elements d-none d-lg-block">
    <div class="floating-cursor-chip chip-teal" style="top: 25%; left: 12%;">
      <svg class="chip-cursor-svg" viewBox="0 0 24 24"><path d="M4 3l15 8-6 2-2 6z"/></svg>
      <span>Status: 404 Missing</span>
    </div>
    <div class="floating-cursor-chip chip-pink" style="top: 30%; right: 12%;">
      <svg class="chip-cursor-svg" viewBox="0 0 24 24" style="transform: rotate(90deg);"><path d="M4 3l15 8-6 2-2 6z"/></svg>
      <span>Lost in Cyberspace</span>
    </div>
  </div>

  <div class="container text-center py-5 position-relative" style="max-width: 640px; z-index: 5;">
    <div class="page-eyebrow mb-3">
      <span class="eyebrow-icon">&#9679;</span>
      <span>404 &mdash; Page Not Found</span>
    </div>

    <div class="mb-3">
      <span class="asterisk-mark" style="font-size: 3.5rem; color: var(--accent-pink);">&#10033;</span>
    </div>

    <h1 class="page-title mb-3">
      Lost on <span class="hero-accent-serif">Campus?</span>
    </h1>

    <p class="page-subtitle mb-4">
      The page or belonging you are seeking cannot be located. The link may have moved or the item report was safely archived after resolution.
    </p>

    <div class="d-flex justify-content-center gap-3">
      <a href="/" class="btn-pill-white">
        <span>Back to Home</span>
        <span class="arrow-chip">&nearr;</span>
      </a>
      <a href="/items" class="btn-pill-ghost">
        <span>Browse Catalog</span>
      </a>
    </div>
  </div>
</main>

<%- include('../../partials/footer') %>
