<%- include('../../partials/head', { title: 'Sign In | Campus Lost & Found' }) %>
<%- include('../../partials/navbar', { activePage: 'login' }) %>

<main class="py-5 position-relative">
  <!-- Subtle ambient glow behind login card -->
  <div class="ambient-glow-wrapper">
    <div class="ambient-glow-center" style="width: 500px; height: 500px; opacity: 0.8;"></div>
  </div>

  <div class="container position-relative" style="max-width: 480px; z-index: 5;">
    <%- include('../../partials/alerts') %>

    <div class="p-4 p-md-5 rounded-4" style="background: var(--bg-surface); border: 1px solid var(--border-medium); box-shadow: var(--shadow-card); backdrop-filter: blur(12px);">
      <div class="text-center mb-4">
        <span class="asterisk-mark mb-2" style="font-size: 2.2rem;">&#10033;</span>
        <h2 class="h3 fw-bold text-white mb-1">Campus Sign In</h2>
        <p class="text-muted small">Log in with your university credentials to manage items and claims</p>
      </div>

      <!-- Quick Demo Login Buttons for Evaluators -->
      <div class="p-3 rounded-3 mb-4 text-center" style="background: #181818; border: 1px solid var(--border-subtle);">
        <div class="small fw-bold text-muted mb-2">&boxbox; Quick Demo Credentials:</div>
        <div class="d-flex justify-content-center gap-2">
          <button type="button" class="btn btn-sm btn-pill-ghost py-1 px-3" id="btnDemoStudent" style="font-size: 0.78rem;">
            Student Demo
          </button>
          <button type="button" class="btn btn-sm py-1 px-3 rounded-pill" id="btnDemoAdmin" style="background: rgba(255,90,112,0.15); color: #ff5a70; border: 1px solid rgba(255,90,112,0.3); font-size: 0.78rem; font-weight: 600;">
            Admin Demo
          </button>
        </div>
      </div>

      <form action="/auth/login" method="POST" id="loginForm">
        <div class="mb-3">
          <label for="loginEmail" class="form-label text-white">Campus Email Address</label>
          <div class="input-group">
            <span class="input-group-text border-end-0 text-muted"><i class="bi bi-envelope"></i></span>
            <input type="email" class="form-control border-start-0 ps-0" id="loginEmail" name="email" placeholder="student@university.edu" required autofocus>
          </div>
        </div>

        <div class="mb-3">
          <div class="d-flex justify-content-between align-items-center mb-1">
            <label for="loginPassword" class="form-label text-white mb-0">Password</label>
            <a href="#" class="small text-muted text-decoration-none" style="font-size: 0.8rem;">Forgot password?</a>
          </div>
          <div class="input-group">
            <span class="input-group-text border-end-0 text-muted"><i class="bi bi-lock"></i></span>
            <input type="password" class="form-control border-start-0 ps-0" id="loginPassword" name="password" placeholder="••••••••" required>
          </div>
        </div>

        <div class="mb-4 form-check">
          <input type="checkbox" class="form-check-input" id="rememberMe" name="rememberMe" style="background-color: #1a1a1a; border-color: rgba(255,255,255,0.2);">
          <label class="form-check-label small text-muted" for="rememberMe">Remember my device</label>
        </div>

        <button type="submit" class="btn-pill-white w-100 justify-content-center py-2 mb-3">
          <span>Sign In to Portal</span>
          <span class="arrow-chip">&nearr;</span>
        </button>

        <div class="text-center small text-muted">
          Don't have an account yet? 
          <a href="/auth/register" class="fw-bold text-white text-decoration-none ms-1">Register as a Student</a>
        </div>
      </form>
    </div>
  </div>
</main>

<%- include('../../partials/footer') %>
