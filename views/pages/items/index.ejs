<%- include('../../partials/head', { title: 'Browse Campus Items | Campus Lost & Found' }) %>
<%- include('../../partials/navbar', { activePage: 'items', activeType: currentFilters.type }) %>

<main class="py-4 position-relative">
  <div class="container">
    <%- include('../../partials/alerts') %>

    <!-- Standard Inner Page Header -->
    <div class="page-header">
      <div class="page-eyebrow">
        <span class="eyebrow-icon">&#9679;</span>
        <span>Campus Registry Directory</span>
      </div>
      <h1 class="page-title">
        Browse <span class="hero-accent-serif">Catalog.</span>
      </h1>
      <p class="page-subtitle">
        Search, filter, and track belongings across university libraries, labs, and student centers.
      </p>

      <div class="d-flex justify-content-center gap-3 mt-4">
        <a href="/items/report?type=lost" class="btn-pill-danger">
          <i class="bi bi-search me-1"></i> Report Lost Item
        </a>
        <a href="/items/report?type=found" class="btn-pill-success">
          <i class="bi bi-plus-circle me-1"></i> Report Found Item
        </a>
      </div>
    </div>

    <!-- Glass Filter Bar -->
    <div class="glass-panel p-4 mb-5">
      <form action="/items" method="GET" id="filterForm">
        <div class="row g-3 align-items-end">
          <!-- Keyword Search -->
          <div class="col-lg-4 col-md-6">
            <label class="form-label small text-muted">Keyword Search</label>
            <div class="input-group">
              <span class="input-group-text border-end-0 text-muted"><i class="bi bi-search"></i></span>
              <input type="text" name="search" class="form-control border-start-0 ps-0" placeholder="e.g. AirPods, Hydro Flask, Student ID..." value="<%= currentFilters.search || '' %>">
            </div>
          </div>

          <!-- Type Filter -->
          <div class="col-lg-2 col-md-6">
            <label class="form-label small text-muted">Type</label>
            <select name="type" class="form-select" onchange="this.form.submit()">
              <option value="" <%= !currentFilters.type ? 'selected' : '' %>>All Types</option>
              <option value="lost" <%= currentFilters.type === 'lost' ? 'selected' : '' %>>Lost Items</option>
              <option value="found" <%= currentFilters.type === 'found' ? 'selected' : '' %>>Found Items</option>
            </select>
          </div>

          <!-- Category Filter -->
          <div class="col-lg-2 col-md-4">
            <label class="form-label small text-muted">Category</label>
            <select name="category" class="form-select" onchange="this.form.submit()">
              <option value="">All Categories</option>
              <option value="electronics" <%= currentFilters.category === 'electronics' ? 'selected' : '' %>>Electronics</option>
              <option value="id_cards" <%= currentFilters.category === 'id_cards' ? 'selected' : '' %>>Student IDs & Cards</option>
              <option value="keys_wallets" <%= currentFilters.category === 'keys_wallets' ? 'selected' : '' %>>Keys & Wallets</option>
              <option value="bags_backpacks" <%= currentFilters.category === 'bags_backpacks' ? 'selected' : '' %>>Bags & Backpacks</option>
              <option value="books_notes" <%= currentFilters.category === 'books_notes' ? 'selected' : '' %>>Books & Notes</option>
              <option value="clothing" <%= currentFilters.category === 'clothing' ? 'selected' : '' %>>Clothing</option>
              <option value="accessories" <%= currentFilters.category === 'accessories' ? 'selected' : '' %>>Accessories</option>
              <option value="sports" <%= currentFilters.category === 'sports' ? 'selected' : '' %>>Sports Equipment</option>
              <option value="other" <%= currentFilters.category === 'other' ? 'selected' : '' %>>Other</option>
            </select>
          </div>

          <!-- Campus Location Filter -->
          <div class="col-lg-2 col-md-4">
            <label class="form-label small text-muted">Campus Area</label>
            <select name="location" class="form-select" onchange="this.form.submit()">
              <option value="">All Campus Areas</option>
              <option value="Main Library" <%= currentFilters.location === 'Main Library' ? 'selected' : '' %>>Main Library</option>
              <option value="Science Block" <%= currentFilters.location === 'Science Block' ? 'selected' : '' %>>Science Block</option>
              <option value="Engineering Quad" <%= currentFilters.location === 'Engineering Quad' ? 'selected' : '' %>>Engineering Quad</option>
              <option value="Central Cafeteria" <%= currentFilters.location === 'Central Cafeteria' ? 'selected' : '' %>>Central Cafeteria</option>
              <option value="Student Center" <%= currentFilters.location === 'Student Center' ? 'selected' : '' %>>Student Center</option>
              <option value="Sports Complex" <%= currentFilters.location === 'Sports Complex' ? 'selected' : '' %>>Sports Complex</option>
              <option value="Dormitory Hall A" <%= currentFilters.location === 'Dormitory Hall A' ? 'selected' : '' %>>Dormitory Hall A</option>
            </select>
          </div>

          <!-- Status Filter -->
          <div class="col-lg-2 col-md-4">
            <label class="form-label small text-muted">Status</label>
            <select name="status" class="form-select" onchange="this.form.submit()">
              <option value="" <%= !currentFilters.status ? 'selected' : '' %>>All Statuses</option>
              <option value="open" <%= currentFilters.status === 'open' ? 'selected' : '' %>>Open</option>
              <option value="under_review" <%= currentFilters.status === 'under_review' ? 'selected' : '' %>>Under Review</option>
              <option value="claimed" <%= currentFilters.status === 'claimed' ? 'selected' : '' %>>Claimed</option>
              <option value="returned" <%= currentFilters.status === 'returned' ? 'selected' : '' %>>Returned</option>
            </select>
          </div>
        </div>

        <div class="d-flex justify-content-between align-items-center mt-4 pt-3 flex-wrap gap-2" style="border-top: 1px solid var(--border-subtle);">
          <div class="d-flex align-items-center gap-2 small text-muted">
            <span>Showing <strong class="text-white"><%= items.length %></strong> of <strong class="text-white"><%= pagination.totalItems %></strong> items</span>
            <% if (currentFilters.search || currentFilters.type || currentFilters.category || currentFilters.location || currentFilters.status) { %>
              <a href="/items" class="badge rounded-pill px-3 py-1 text-decoration-none" style="background: rgba(255,255,255,0.08); color: var(--text-muted); border: 1px solid var(--border-subtle);">
                <i class="bi bi-x-circle me-1"></i> Clear Filters
              </a>
            <% } %>
          </div>

          <div class="d-flex gap-2">
            <button type="submit" class="btn-pill-white btn-sm px-4">
              <span>Filter Catalog</span>
              <span class="arrow-chip" style="width: 18px; height: 18px; font-size: 0.65rem;">&rarr;</span>
            </button>
            <a href="/items" class="btn-pill-ghost btn-sm px-3">Reset</a>
          </div>
        </div>
      </form>
    </div>

    <!-- Items Listing Grid -->
    <div class="row g-4">
      <% if (items && items.length > 0) { %>
        <% items.forEach(item => { %>
          <%- include('../../partials/item-card', { item: item }) %>
        <% }); %>
      <% } else { %>
        <div class="col-12">
          <div class="glass-panel text-center py-5 p-4">
            <i class="bi bi-search display-4 text-muted mb-3 d-block"></i>
            <h4 class="fw-bold text-white">No items found</h4>
            <p class="text-muted mx-auto" style="max-width: 500px;">
              We couldn't find any reports matching your search and filter criteria. Try clearing some filters or searching with different keywords.
            </p>
            <div class="d-flex justify-content-center gap-2 mt-4">
              <a href="/items" class="btn-pill-ghost">Clear All Filters</a>
              <a href="/items/report" class="btn-pill-white">
                <span>Submit a Report</span>
                <span class="arrow-chip">&nearr;</span>
              </a>
            </div>
          </div>
        </div>
      <% } %>
    </div>

    <!-- Pagination Controls (Pill Buttons) -->
    <% if (pagination.totalPages > 1) { %>
      <nav aria-label="Page navigation" class="mt-5">
        <ul class="pagination justify-content-center gap-2">
          <li class="page-item <%= pagination.currentPage <= 1 ? 'disabled' : '' %>">
            <a class="btn-pill-ghost btn-sm rounded-pill px-3 text-decoration-none" href="/items?page=<%= pagination.currentPage - 1 %>">Previous</a>
          </li>

          <% for (let p = 1; p <= pagination.totalPages; p++) { %>
            <li class="page-item <%= pagination.currentPage === p ? 'active' : '' %>">
              <a class="btn-pill-ghost btn-sm rounded-pill px-3 text-decoration-none" style="<%= pagination.currentPage === p ? 'background: #ffffff; color: #000000 !important; font-weight: 700;' : '' %>" href="/items?page=<%= p %>"><%= p %></a>
            </li>
          <% } %>

          <li class="page-item <%= pagination.currentPage >= pagination.totalPages ? 'disabled' : '' %>">
            <a class="btn-pill-ghost btn-sm rounded-pill px-3 text-decoration-none" href="/items?page=<%= pagination.currentPage + 1 %>">Next</a>
          </li>
        </ul>
      </nav>
    <% } %>
  </div>
</main>

<%- include('../../partials/claim-modal') %>
<%- include('../../partials/footer') %>
