<%- include('../../partials/head', { title: 'My Dashboard | Campus Lost & Found' }) %>
<%- include('../../partials/navbar', { activePage: 'dashboard' }) %>

<main class="py-4 position-relative">
  <div class="container">
    <%- include('../../partials/alerts') %>

    <!-- Standard Inner Page Header -->
    <div class="page-header text-center mb-4">
      <div class="page-eyebrow">
        <span class="eyebrow-icon">&#9679;</span>
        <span>Student Workspace</span>
      </div>
      <h1 class="page-title">
        My <span class="hero-accent-serif">Dashboard.</span>
      </h1>
      <p class="page-subtitle">
        Manage your active reports, track submitted claims, and inspect custody verification status.
      </p>
    </div>

    <!-- Student Profile & Dashboard Banner -->
    <div class="glass-panel p-4 mb-4">
      <div class="row align-items-center g-3">
        <div class="col-md-7">
          <div class="d-flex align-items-center gap-3">
            <div class="rounded-circle d-flex align-items-center justify-content-center fs-3 fw-bold" style="width: 58px; height: 58px; background: rgba(230,242,107,0.15); color: var(--accent-lime); border: 1px solid rgba(230,242,107,0.3);">
              <%= currentUser.name.charAt(0).toUpperCase() %>
            </div>
            <div>
              <h2 class="h3 fw-bold text-white mb-0"><%= currentUser.name %></h2>
              <div class="text-muted small mt-1">
                <i class="bi bi-envelope me-1"></i> <%= currentUser.email %> 
                <span class="badge rounded-pill ms-2" style="background: rgba(25,181,232,0.15); color: var(--accent-cyan); border: 1px solid rgba(25,181,232,0.3);">
                  <%= currentUser.role === 'admin' ? 'Campus Admin' : 'Registered Student' %>
                </span>
              </div>
            </div>
          </div>
        </div>

        <div class="col-md-5 text-md-end">
          <a href="/items/report" class="btn-pill-white">
            <span>Report New Item</span>
            <span class="arrow-chip">&nearr;</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Metric Stats Row -->
    <div class="row g-3 mb-4">
      <div class="col-md-4">
        <div class="dashboard-stat-card">
          <div class="stat-icon-wrap stat-icon-blue">
            <i class="bi bi-file-earmark-text"></i>
          </div>
          <div>
            <div class="text-muted small fw-semibold">My Reports</div>
            <h3 class="fw-bold mb-0 text-white"><%= myReports.length %></h3>
          </div>
        </div>
      </div>

      <div class="col-md-4">
        <div class="dashboard-stat-card">
          <div class="stat-icon-wrap stat-icon-amber">
            <i class="bi bi-shield-check"></i>
          </div>
          <div>
            <div class="text-muted small fw-semibold">My Claims</div>
            <h3 class="fw-bold mb-0 text-white"><%= myClaims.length %></h3>
          </div>
        </div>
      </div>

      <div class="col-md-4">
        <div class="dashboard-stat-card">
          <div class="stat-icon-wrap stat-icon-green">
            <i class="bi bi-check2-circle"></i>
          </div>
          <div>
            <div class="text-muted small fw-semibold">Reunited Items</div>
            <h3 class="fw-bold mb-0" style="color: var(--accent-lime);">
              <%= myReports.filter(r => r.status === 'returned').length + myClaims.filter(c => c.status === 'approved').length %>
            </h3>
          </div>
        </div>
      </div>
    </div>

    <!-- Tabs: Reports vs Claims -->
    <div class="glass-panel overflow-hidden">
      <div class="border-bottom p-3" style="border-color: var(--border-subtle) !important; background: #151515;">
        <ul class="nav gap-2" id="dashboardTab" role="tablist">
          <li class="nav-item" role="presentation">
            <button class="btn btn-pill-white btn-sm active" id="reports-tab" data-bs-toggle="tab" data-bs-target="#reports-pane" type="button" role="tab" aria-controls="reports-pane" aria-selected="true">
              <i class="bi bi-folder2-open me-1"></i> My Reported Items (<%= myReports.length %>)
            </button>
          </li>
          <li class="nav-item" role="presentation">
            <button class="btn btn-pill-ghost btn-sm" id="claims-tab" data-bs-toggle="tab" data-bs-target="#claims-pane" type="button" role="tab" aria-controls="claims-pane" aria-selected="false">
              <i class="bi bi-patch-check me-1"></i> My Claims (<%= myClaims.length %>)
            </button>
          </li>
        </ul>
      </div>

      <div class="p-4">
        <div class="tab-content" id="dashboardTabContent">
          <!-- Tab 1: My Reports -->
          <div class="tab-pane fade show active" id="reports-pane" role="tabpanel" aria-labelledby="reports-tab">
            <% if (myReports && myReports.length > 0) { %>
              <div class="table-responsive">
                <table class="table table-custom align-middle">
                  <thead>
                    <tr>
                      <th>Item Details</th>
                      <th>Type</th>
                      <th>Location</th>
                      <th>Date</th>
                      <th>Status</th>
                      <th class="text-end">Actions</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% myReports.forEach(report => { %>
                      <tr>
                        <td>
                          <div class="d-flex align-items-center gap-3">
                            <% if (report.imageUrl || report.image_url) { %>
                              <img src="<%= report.imageUrl || report.image_url %>" class="rounded-3" style="width: 48px; height: 48px; object-fit: cover;" alt="">
                            <% } else { %>
                              <div class="rounded-3 d-flex align-items-center justify-content-center text-muted" style="width: 48px; height: 48px; background: #1a1a1a;">
                                <i class="bi bi-box"></i>
                              </div>
                            <% } %>
                            <div>
                              <a href="/items/<%= report.id || report._id %>" class="fw-bold text-white text-decoration-none">
                                <%= report.title %>
                              </a>
                              <div class="small text-muted"><%= (report.category || '').replace(/_/g, ' ') %></div>
                            </div>
                          </div>
                        </td>
                        <td>
                          <span class="badge rounded-pill px-3 py-1" style="background: <%= report.type === 'lost' ? 'var(--lost-bg)' : 'var(--found-bg)' %>; color: <%= report.type === 'lost' ? 'var(--lost-color)' : 'var(--found-color)' %>; border: 1px solid <%= report.type === 'lost' ? 'var(--lost-border)' : 'var(--found-border)' %>;">
                            <%= report.type.toUpperCase() %>
                          </span>
                        </td>
                        <td>
                          <div class="small"><i class="bi bi-geo-alt me-1" style="color: var(--accent-pink);"></i><%= report.location %></div>
                        </td>
                        <td>
                          <div class="small text-muted"><%= new Date(report.dateLostOrFound || report.date_lost_or_found).toLocaleDateString() %></div>
                        </td>
                        <td>
                          <span class="badge badge-status status-<%= report.status %>">
                            <%= report.status.replace('_', ' ').toUpperCase() %>
                          </span>
                        </td>
                        <td class="text-end">
                          <a href="/items/<%= report.id || report._id %>" class="btn-pill-ghost btn-sm px-3">
                            <span>View</span>
                            <span class="arrow-chip" style="width: 16px; height: 16px; font-size: 0.6rem;">&rarr;</span>
                          </a>
                        </td>
                      </tr>
                    <% }); %>
                  </tbody>
                </table>
              </div>
            <% } else { %>
              <div class="text-center py-5">
                <i class="bi bi-inbox display-4 text-muted mb-3 d-block"></i>
                <h5 class="fw-bold text-white">No reports logged yet</h5>
                <p class="text-muted small">Have you lost or found something on campus?</p>
                <a href="/items/report" class="btn-pill-white">Submit a Report</a>
              </div>
            <% } %>
          </div>

          <!-- Tab 2: My Claims -->
          <div class="tab-pane fade" id="claims-pane" role="tabpanel" aria-labelledby="claims-tab">
            <% if (myClaims && myClaims.length > 0) { %>
              <div class="table-responsive">
                <table class="table table-custom align-middle">
                  <thead>
                    <tr>
                      <th>Target Item</th>
                      <th>Proof Submitted</th>
                      <th>Claim Date</th>
                      <th>Status</th>
                      <th>Next Step</th>
                      <th class="text-end">Action</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% myClaims.forEach(claim => { %>
                      <tr>
                        <td>
                          <div class="fw-bold text-white"><%= claim.item ? claim.item.title : 'Item #' + claim.itemId %></div>
                          <small class="text-muted">Ref: <%= (claim.itemId || '').toString().substring(0, 8) %></small>
                        </td>
                        <td>
                          <div class="text-truncate small text-muted" style="max-width: 260px;" title="<%= claim.proofDescription %>">
                            <%= claim.proofDescription %>
                          </div>
                        </td>
                        <td>
                          <div class="small text-muted"><%= new Date(claim.createdAt).toLocaleDateString() %></div>
                        </td>
                        <td>
                          <% if (claim.status === 'pending') { %>
                            <span class="badge rounded-pill px-3 py-1" style="background: var(--review-bg); color: var(--review-color); border: 1px solid var(--review-border);">
                              <i class="bi bi-hourglass-split me-1"></i> Review
                            </span>
                          <% } else if (claim.status === 'approved') { %>
                            <span class="badge rounded-pill px-3 py-1" style="background: var(--found-bg); color: var(--found-color); border: 1px solid var(--found-border);">
                              <i class="bi bi-check-circle-fill me-1"></i> Approved
                            </span>
                          <% } else { %>
                            <span class="badge rounded-pill px-3 py-1" style="background: var(--lost-bg); color: var(--lost-color); border: 1px solid var(--lost-border);">
                              <i class="bi bi-x-circle me-1"></i> Rejected
                            </span>
                          <% } %>
                        </td>
                        <td>
                          <% if (claim.status === 'approved') { %>
                            <span class="small fw-semibold" style="color: var(--accent-lime);">
                              <i class="bi bi-building"></i> Collect at Student Center Room 102
                            </span>
                          <% } else if (claim.status === 'pending') { %>
                            <span class="small text-muted">Awaiting security staff verification</span>
                          <% } else { %>
                            <span class="small" style="color: var(--lost-color);">Proof insufficient. Contact desk.</span>
                          <% } %>
                        </td>
                        <td class="text-end">
                          <a href="/items/<%= claim.itemId %>" class="btn-pill-ghost btn-sm px-3">
                            View Item
                          </a>
                        </td>
                      </tr>
                    <% }); %>
                  </tbody>
                </table>
              </div>
            <% } else { %>
              <div class="text-center py-5">
                <i class="bi bi-shield-x display-4 text-muted mb-3 d-block"></i>
                <h5 class="fw-bold text-white">No claims filed yet</h5>
                <p class="text-muted small">Browse found items to claim something that belongs to you.</p>
                <a href="/items?type=found" class="btn-pill-white">Browse Found Items</a>
              </div>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </div>
</main>

<%- include('../../partials/footer') %>
