# =================================================================
# Campus Lost & Found - Environment Configuration Template
# =================================================================

# Server Port
PORT=3000

# Environment Mode (development / production)
NODE_ENV=development

# Session Encryption Secret (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# =================================================================
# Supabase Database Configuration
# 1. Create a free project at https://supabase.com
# 2. Go to Project Settings -> API to copy your Project URL & Service Role Key:
# =================================================================
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key  # from Supabase > Settings > API > service_role

# Collection / pickup location shown to approved claimants
COLLECTION_LOCATION=Student Center Security Desk, Room 102

# Optional SMTP for email notifications (leave blank to disable)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@university.edu
