<%- include('../../partials/head', { title: item.title + ' | Campus Lost & Found' }) %>
<%- include('../../partials/navbar', { activePage: 'items' }) %>

<main class="py-4">
  <div class="container">
    <%- include('../../partials/alerts') %>

    <!-- Breadcrumb Navigation -->
    <nav aria-label="breadcrumb" class="mb-4">
      <ol class="breadcrumb small">
        <li class="breadcrumb-item"><a href="/" class="text-decoration-none">Home</a></li>
        <li class="breadcrumb-item"><a href="/items" class="text-decoration-none">Items Directory</a></li>
        <li class="breadcrumb-item active text-truncate" aria-current="page" style="max-width: 300px;"><%= item.title %></li>
      </ol>
    </nav>

    <!-- Potential Duplicate / Match Warning Banner (if present) -->
    <% if (typeof potentialMatch !== 'undefined' && potentialMatch) { %>
      <div class="duplicate-alert-banner">
        <i class="bi bi-lightbulb-fill fs-4 mt-1"></i>
        <div class="flex-grow-1">
          <div class="fw-bold">Potential <%= item.type === 'lost' ? 'Found' : 'Lost' %> Match Detected!</div>
          <p class="mb-2 small">
            A similar item entitled <strong>"<%= potentialMatch.title %>"</strong> was reported at <strong><%= potentialMatch.location %></strong> on <%= new Date(potentialMatch.dateLostOrFound).toLocaleDateString() %>.
          </p>
          <a href="/items/<%= potentialMatch._id %>" class="btn btn-warning btn-sm fw-bold rounded-pill px-3">
            <i class="bi bi-eye me-1"></i> Review Matched Item
          </a>
        </div>
      </div>
    <% } %>

    <div class="row g-4">
      <!-- Left Column: Item Image & Security Protocol -->
      <div class="col-lg-5">
        <div class="item-detail-gallery mb-4">
          <% if (item.imageUrl) { %>
            <img src="<%= item.imageUrl %>" alt="<%= item.title %>" class="img-fluid rounded-3" onerror="this.onerror=null; this.parentElement.innerHTML='<div class=\'text-center p-5\'><i class=\'bi bi-box-seam display-1 text-muted\'></i><p class=\'text-muted mt-2\'>No photo provided</p></div>';">
          <% } else { %>
            <div class="text-center p-5">
              <i class="bi <%= item.type === 'lost' ? 'bi-search' : 'bi-box-seam' %> display-1 text-secondary"></i>
              <p class="text-muted mt-2 mb-0">No item image uploaded</p>
            </div>
          <% } %>
        </div>

        <!-- Safe Recovery Card -->
        <div class="p-3 bg-card-dark rounded-4 border shadow-sm">
          <h6 class="fw-bold text-white d-flex align-items-center gap-2 mb-2">
            <i class="bi bi-shield-check text-success"></i> Campus Handover Protocol
          </h6>
          <p class="small text-muted mb-2">
            Items registered through the portal must be surrendered to or claimed from the <strong>Student Center Security Desk</strong>.
          </p>
          <div class="small bg-dark-alt p-2 rounded-3 text-secondary">
            <i class="bi bi-info-circle me-1 text-primary"></i> Be prepared to show your Student ID and demonstrate proof of ownership.
          </div>
        </div>
      </div>

      <!-- Right Column: Metadata, Description & Claim Action -->
      <div class="col-lg-7">
        <div class="item-detail-meta-card">
          <!-- Stepper / Status Progression -->
          <div class="stepper-progress">
            <div class="stepper-step <%= item.status === 'open' || item.status === 'under_review' || item.status === 'claimed' || item.status === 'returned' ? 'completed' : '' %>">
              <div class="stepper-circle"><i class="bi bi-check-lg"></i></div>
              <div class="stepper-title">Reported</div>
            </div>
            <div class="stepper-step <%= item.status === 'under_review' || item.status === 'claimed' || item.status === 'returned' ? (item.status === 'under_review' ? 'active' : 'completed') : '' %>">
              <div class="stepper-circle">2</div>
              <div class="stepper-title">Under Review</div>
            </div>
            <div class="stepper-step <%= item.status === 'claimed' || item.status === 'returned' ? (item.status === 'claimed' ? 'active' : 'completed') : '' %>">
              <div class="stepper-circle">3</div>
              <div class="stepper-title">Claimed</div>
            </div>
            <div class="stepper-step <%= item.status === 'returned' ? 'completed' : '' %>">
              <div class="stepper-circle">4</div>
              <div class="stepper-title">Returned</div>
            </div>
          </div>

          <!-- Header Tags & Title -->
          <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
            <span class="badge <%= item.type === 'lost' ? 'bg-danger text-white' : 'bg-success text-white' %> px-3 py-2 rounded-pill fw-bold text-uppercase">
              <i class="bi <%= item.type === 'lost' ? 'bi-exclamation-circle' : 'bi-check-circle' %> me-1"></i>
              <%= item.type === 'lost' ? 'Lost Item' : 'Found Item' %>
            </span>

            <span class="badge badge-status status-<%= item.status %> px-3 py-2">
              Status: <%= item.status.replace('_', ' ').toUpperCase() %>
            </span>

            <span class="badge bg-dark-alt text-muted border px-3 py-2 rounded-pill ms-auto">
              Ref ID: <%= item._id %>
            </span>
          </div>

          <h2 class="h2 fw-bold text-white mb-3"><%= item.title %></h2>

          <div class="mb-4">
            <h6 class="fw-bold text-muted small text-uppercase">Item Description</h6>
            <p class="text-secondary" style="white-space: pre-line; line-height: 1.7;"><%= item.description %></p>
          </div>

          <!-- Specifications Table -->
          <table class="table meta-spec-table mb-4">
            <tbody>
              <tr>
                <th>Category</th>
                <td><i class="bi bi-tag text-primary me-2"></i><%= item.category.replace('_', ' ') %></td>
              </tr>
              <tr>
                <th>Campus Location</th>
                <td><i class="bi bi-geo-alt-fill text-danger me-2"></i><%= item.location %></td>
              </tr>
              <tr>
                <th>Date <%= item.type === 'lost' ? 'Lost' : 'Found' %></th>
                <td><i class="bi bi-calendar-event text-primary me-2"></i><%= new Date(item.dateLostOrFound).toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %></td>
              </tr>
              <tr>
                <th>Date Logged</th>
                <td><i class="bi bi-clock-history text-muted me-2"></i><%= new Date(item.createdAt).toLocaleDateString() %></td>
              </tr>
              <tr>
                <th>Reported By</th>
                <td>
                  <i class="bi bi-person-circle text-secondary me-2"></i>
                  <%= item.reportedBy ? item.reportedBy.name : 'Campus Community Member' %>
                  <% if (item.reportedBy && item.reportedBy.role === 'admin') { %>
                    <span class="badge bg-danger-subtle text-danger ms-1">Security Staff</span>
                  <% } %>
                </td>
              </tr>
            </tbody>
          </table>

          <!-- Action Buttons -->
          <div class="d-flex flex-wrap gap-3 pt-3 border-top">
            <% if (item.type === 'found' && (item.status === 'open' || item.status === 'under_review')) { %>
              <button type="button" class="btn btn-primary btn-lg rounded-pill px-4 shadow-sm fw-bold" data-bs-toggle="modal" data-bs-target="#claimItemModal" data-item-id="<%= item._id %>" data-item-title="<%= item.title %>">
                <i class="bi bi-shield-check me-2"></i> This Is Mine (Submit Claim)
              </button>
            <% } else if (item.type === 'lost' && item.status === 'open') { %>
              <a href="/items/report?type=found&matchedTitle=<%= encodeURIComponent(item.title) %>" class="btn btn-success btn-lg rounded-pill px-4 shadow-sm fw-bold">
                <i class="bi bi-hand-index-thumb me-2"></i> I Found This Item
              </a>
            <% } %>

            <a href="/items" class="btn btn-outline-secondary btn-lg rounded-pill px-4">
              <i class="bi bi-arrow-left me-1"></i> Back to Catalog
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</main>

<%- include('../../partials/claim-modal') %>
<%- include('../../partials/footer') %>
