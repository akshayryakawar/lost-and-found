<%- include('../../partials/head', { title: 'Edit Report: ' + item.title + ' | Campus Lost & Found' }) %>
<%- include('../../partials/navbar', { activePage: 'items' }) %>

<main class="py-4 position-relative">
  <div class="container" style="max-width: 820px;">
    <%- include('../../partials/alerts') %>

    <!-- Standard Inner Page Header -->
    <div class="page-header">
      <div class="page-eyebrow">
        <span class="eyebrow-icon">&#9679;</span>
        <span>Modify Open Report</span>
      </div>
      <h1 class="page-title">
        Edit <span class="hero-accent-serif">Belonging.</span>
      </h1>
      <p class="page-subtitle">
        Update details for your reported item while it remains open and awaiting claim verification.
      </p>
    </div>

    <!-- Glass Form Card -->
    <div class="glass-panel p-4 p-md-5">
      <form action="/items/<%= item.id || item._id %>/edit" method="POST" id="editItemForm" class="needs-validation" novalidate>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <!-- Type Selector (Readonly indicator) -->
        <div class="mb-4 text-center">
          <label class="form-label d-block small text-uppercase fw-bold mb-2" style="color: var(--accent-lime); letter-spacing: 0.06em;">Report Type</label>
          <span class="badge px-4 py-2 rounded-pill fw-bold" style="background: <%= item.type === 'lost' ? 'var(--lost-bg)' : 'var(--found-bg)' %>; color: <%= item.type === 'lost' ? 'var(--lost-color)' : 'var(--found-color)' %>; border: 1px solid <%= item.type === 'lost' ? 'var(--lost-border)' : 'var(--found-border)' %>;">
            <i class="bi <%= item.type === 'lost' ? 'bi-search' : 'bi-plus-circle' %> me-1"></i>
            <%= item.type === 'lost' ? 'Lost Item' : 'Found Item' %>
          </span>
          <input type="hidden" name="type" value="<%= item.type %>">
        </div>

        <div class="row g-3">
          <!-- Item Title -->
          <div class="col-12">
            <label for="editTitle" class="form-label text-white">
              Item Title / Name <span style="color: var(--lost-color);">*</span>
            </label>
            <input type="text" class="form-control form-control-lg fs-6" id="editTitle" name="title" value="<%= item.title %>" required>
            <div class="invalid-feedback">Please provide a descriptive item title.</div>
          </div>

          <!-- Category -->
          <div class="col-md-6">
            <label for="editCategory" class="form-label text-white">
              Category <span style="color: var(--lost-color);">*</span>
            </label>
            <select class="form-select" id="editCategory" name="category" required>
              <option value="electronics" <%= item.category === 'electronics' ? 'selected' : '' %>>Electronics (Phones, Laptops, Earbuds, Chargers)</option>
              <option value="id_cards" <%= item.category === 'id_cards' ? 'selected' : '' %>>Student IDs, Bank Cards, Badges</option>
              <option value="keys_wallets" <%= item.category === 'keys_wallets' ? 'selected' : '' %>>Keys, Wallets, Purses</option>
              <option value="bags_backpacks" <%= item.category === 'bags_backpacks' ? 'selected' : '' %>>Bags, Backpacks, Luggage</option>
              <option value="books_notes" <%= item.category === 'books_notes' ? 'selected' : '' %>>Books, Notebooks, Courseware</option>
              <option value="clothing" <%= item.category === 'clothing' ? 'selected' : '' %>>Clothing, Jackets, Footwear</option>
              <option value="accessories" <%= item.category === 'accessories' ? 'selected' : '' %>>Watches, Jewelry, Glasses</option>
              <option value="sports" <%= item.category === 'sports' ? 'selected' : '' %>>Sports &amp; Fitness Equipment</option>
              <option value="other" <%= item.category === 'other' ? 'selected' : '' %>>Other / Miscellaneous</option>
            </select>
            <div class="invalid-feedback">Please select a category.</div>
          </div>

          <!-- Campus Location -->
          <div class="col-md-6">
            <label for="editLocation" class="form-label text-white">
              Campus Location <span style="color: var(--lost-color);">*</span>
            </label>
            <input type="text" class="form-control" id="editLocation" name="location" value="<%= item.location %>" required>
            <div class="invalid-feedback">Please specify the location.</div>
          </div>

          <!-- Date Lost or Found -->
          <div class="col-md-6">
            <label for="editDate" class="form-label text-white">
              Date Lost or Found <span style="color: var(--lost-color);">*</span>
            </label>
            <% 
              const rawDate = item.dateLostOrFound || item.date_lost_or_found;
              const dateVal = rawDate ? new Date(rawDate).toISOString().split('T')[0] : '';
            %>
            <input type="date" class="form-control" id="editDate" name="dateLostOrFound" value="<%= dateVal %>" required max="<%= new Date().toISOString().split('T')[0] %>">
            <div class="invalid-feedback">Please select a valid date.</div>
          </div>

          <!-- Description -->
          <div class="col-12">
            <label for="editDescription" class="form-label text-white">
              Detailed Description <span style="color: var(--lost-color);">*</span>
            </label>
            <textarea class="form-control" id="editDescription" name="description" rows="4" required minlength="5"><%= item.description %></textarea>
            <div class="small text-muted mt-1">Detailed descriptions increase match accuracy by over 80%.</div>
          </div>
        </div>

        <div class="d-flex justify-content-between align-items-center mt-5 pt-3" style="border-top: 1px solid var(--border-subtle);">
          <a href="/items/<%= item.id || item._id %>" class="btn-pill-ghost">Cancel</a>
          <button type="submit" class="btn-pill-white px-4 py-2">
            <span>Save Changes</span>
            <span class="arrow-chip">&nearr;</span>
          </button>
        </div>
      </form>
    </div>
  </div>
</main>

<%- include('../../partials/footer') %>
