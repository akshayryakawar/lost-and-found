<%- include('../../partials/head', { title: 'Forgot Password | Campus Lost & Found' }) %>
<%- include('../../partials/navbar', { activePage: 'login' }) %>

<main class="py-5 position-relative">
  <!-- Ambient glow blobs behind the centered card -->
  <div class="ambient-glow-wrapper">
    <div class="ambient-glow-top"></div>
    <div class="ambient-glow-center" style="width: 520px; height: 520px; opacity: 0.9;"></div>
  </div>

  <div class="container position-relative" style="max-width: 480px; z-index: 5;">
    <%- include('../../partials/alerts') %>

    <!-- Standard Page Header -->
    <div class="page-header text-center mb-4">
      <div class="page-eyebrow">
        <span class="eyebrow-icon">&#9679;</span>
        <span>Account Recovery</span>
      </div>
      <h1 class="page-title">
        Reset <span class="hero-accent-serif">Password.</span>
      </h1>
      <p class="page-subtitle">
        Enter your verified campus email address to receive password reset instructions.
      </p>
    </div>

    <!-- Centered Glass Card -->
    <div class="glass-panel p-4 p-md-5">
      <form action="/auth/forgot-password" method="POST" id="forgotPasswordForm">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div class="mb-4">
          <label for="resetEmail" class="form-label text-white">Campus Email Address</label>
          <div class="input-group">
            <span class="input-group-text border-end-0 text-muted"><i class="bi bi-envelope"></i></span>
            <input type="email" class="form-control border-start-0 ps-0" id="resetEmail" name="email" placeholder="student@university.edu" required autofocus>
          </div>
        </div>

        <button type="submit" class="btn-pill-white w-100 justify-content-center py-2 mb-3">
          <span>Send Reset Link</span>
          <span class="arrow-chip">&nearr;</span>
        </button>

        <div class="text-center small text-muted">
          Remembered your password? 
          <a href="/auth/login" class="fw-bold text-white text-decoration-none ms-1">Back to Login</a>
        </div>
      </form>
    </div>
  </div>
</main>

<%- include('../../partials/footer') %>
