# =================================================================
# Campus Lost & Found - Environment Configuration Template
# =================================================================

# Server Port
PORT=3000

# Environment Mode (development / production)
NODE_ENV=development

# Session Encryption Secret
SESSION_SECRET=

# =================================================================
# Supabase Database Configuration
# 1. Create a free project at https://supabase.com
# 2. Go to Project Settings -> API to copy your Project URL & Anon/Service Role Key:
# =================================================================
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key

# Optional: MongoDB connection string (if running MongoDB concurrently)
MONGODB_URI=mongodb://127.0.0.1:27017/campus_lost_and_found
