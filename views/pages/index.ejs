<%- include('../partials/head', { title: 'Campus Lost & Found | Official University Portal' }) %>
<%- include('../partials/navbar', { activePage: 'home' }) %>

<main class="position-relative">
  <!-- Ambient Radial Glows & Subtle Texture -->
  <div class="ambient-glow-wrapper">
    <div class="ambient-glow-top"></div>
    <div class="ambient-glow-center"></div>
    <div class="starfield-texture"></div>
  </div>

  <!-- =========================================================================
       HERO SECTION WITH FLOATING CHIPS & SIGNATURE CARD FAN
       ========================================================================= -->
  <section class="hero-section">
    <!-- Floating Cursor Name-Tag Chips & 3D Shapes -->
    <div class="hero-floating-elements d-none d-lg-block">
      <!-- Teal Chip (Left) -->
      <a href="/items?type=found" class="floating-cursor-chip chip-teal" title="View Found AirPods">
        <svg class="chip-cursor-svg" viewBox="0 0 24 24">
          <path d="M4 3l15 8-6 2-2 6z"/>
        </svg>
        <span>Found: AirPods Pro</span>
      </a>

      <!-- Coral Pink Chip (Right) -->
      <a href="/items?type=lost" class="floating-cursor-chip chip-pink" title="View Lost Wallet">
        <svg class="chip-cursor-svg" viewBox="0 0 24 24" style="transform: rotate(90deg);">
          <path d="M4 3l15 8-6 2-2 6z"/>
        </svg>
        <span>Lost: Leather Wallet</span>
      </a>

      <!-- Floating 3D Decorative Megaphone -->
      <div class="floating-3d-shape shape-megaphone">
        <svg viewBox="0 0 80 80" width="100%" height="100%">
          <defs>
            <linearGradient id="megaGrad" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#38e1ff"/>
              <stop offset="100%" stop-color="#12b0e8"/>
            </linearGradient>
          </defs>
          <path d="M20 30 L45 15 L45 65 L20 50 Z" fill="url(#megaGrad)" opacity="0.9"/>
          <ellipse cx="45" cy="40" rx="8" ry="25" fill="#5ee475"/>
          <rect x="14" y="34" width="8" height="12" rx="3" fill="#ffffff" opacity="0.8"/>
        </svg>
      </div>

      <!-- Floating 3D Decorative Monitor -->
      <div class="floating-3d-shape shape-monitor">
        <svg viewBox="0 0 80 80" width="100%" height="100%">
          <defs>
            <linearGradient id="monGrad" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#ff6b81"/>
              <stop offset="100%" stop-color="#7b5cff"/>
            </linearGradient>
          </defs>
          <rect x="15" y="15" width="50" height="38" rx="8" fill="url(#monGrad)"/>
          <rect x="20" y="20" width="40" height="28" rx="4" fill="#141414"/>
          <path d="M35 53 L45 53 L48 64 L32 64 Z" fill="#ffffff" opacity="0.7"/>
        </svg>
      </div>
    </div>

    <div class="container position-relative" style="z-index: 5;">
      <!-- Small Eyebrow Label -->
      <div class="hero-eyebrow">
        <span class="eyebrow-icon">&#9679;</span>
        <span>Live Campus Recovery Network &mdash; Lose Nothing, Find Everything</span>
      </div>

      <!-- Two-line Big Headline -->
      <h1 class="hero-headline">
        Lose Nothing.
        <span class="hero-accent-serif">Find Everything.</span>
      </h1>

      <!-- Muted Subtitle -->
      <p class="hero-subtitle">
        A campus space where lost belongings find their way home &mdash; report, track, and safely claim items across all student halls, libraries, and facilities in seconds.
      </p>

      <!-- Primary Action Buttons -->
      <div class="hero-cta-group">
        <a href="/items/report" class="btn-pill-white">
          <span>Report an Item</span>
          <span class="arrow-chip" aria-hidden="true">&nearr;</span>
        </a>
        <a href="/items" class="btn-pill-ghost">
          <span>Browse All Items</span>
        </a>
      </div>

      <!-- =====================================================================
           SIGNATURE CARD FAN (HERO CAROUSEL)
           ===================================================================== -->
      <div class="card-fan-section">
        <div class="card-fan-container" id="heroCardFan">
          
          <% 
            // Build 5 visual cards combining real items and themed backups
            const sampleFanPresets = [
              { title: 'AirPods Pro', category: 'Electronics', colorClass: 'fan-card-1', icon: 'bi-headphones', img: '/images/sample-airpods.jpg' },
              { title: 'Student ID', category: 'Cards & Badges', colorClass: 'fan-card-2', icon: 'bi-person-badge', img: '/images/sample-id.jpg' },
              { title: 'Smart Watch', category: 'Accessories', colorClass: 'fan-card-3', icon: 'bi-smartwatch', img: '/images/sample-watch.jpg' },
              { title: 'Notebook & Pen', category: 'Courseware', colorClass: 'fan-card-4', icon: 'bi-journal-bookmark', img: '/images/sample-book.jpg' },
              { title: 'Leather Wallet', category: 'Keys & Wallets', colorClass: 'fan-card-5', icon: 'bi-wallet2', img: '/images/sample-wallet.jpg' }
            ];

            const cardsToRender = [];
            for (let i = 0; i < 5; i++) {
              if (recentItems && recentItems[i]) {
                cardsToRender.push({
                  id: recentItems[i].id || recentItems[i]._id,
                  title: recentItems[i].title,
                  category: (recentItems[i].category || 'Campus Item').replace('_', ' '),
                  colorClass: `fan-card-${i + 1}`,
                  imageUrl: recentItems[i].imageUrl || recentItems[i].image_url,
                  type: recentItems[i].type
                });
              } else {
                cardsToRender.push({
                  id: null,
                  title: sampleFanPresets[i].title,
                  category: sampleFanPresets[i].category,
                  colorClass: sampleFanPresets[i].colorClass,
                  icon: sampleFanPresets[i].icon,
                  imageUrl: null,
                  type: 'found'
                });
              }
            }
          %>

          <% cardsToRender.forEach((card, index) => { %>
            <a href="<%= card.id ? '/items/' + card.id : '/items' %>" class="fan-card <%= card.colorClass %>" aria-label="View <%= card.title %>">
              <div class="fan-card-header">
                <div class="fan-card-title text-truncate"><%= card.title %></div>
                <div class="fan-card-subtitle"><%= card.category %></div>
              </div>

              <% if (index === 2) { %>
                <!-- Center Prominent Card "Get Started" chip -->
                <div class="fan-center-pill">
                  <span>Get Started</span>
                  <span class="arrow-chip">&nearr;</span>
                </div>
              <% } %>

              <div class="fan-card-artwork">
                <% if (card.imageUrl) { %>
                  <img src="<%= card.imageUrl %>" alt="<%= card.title %>" onerror="this.onerror=null; this.parentElement.innerHTML='<div class=\'fan-artwork-fallback\'><i class=\'bi bi-box-seam\'></i></div>';">
                <% } else { %>
                  <div class="fan-artwork-fallback">
                    <i class="bi <%= card.icon || 'bi-box-seam' %>"></i>
                  </div>
                <% } %>
              </div>
            </a>
          <% }); %>

        </div>
      </div>

    </div>
  </section>

  <!-- =========================================================================
       LIVE STATS STRIP
       ========================================================================= -->
  <section class="stats-strip-container">
    <div class="container">
      <div class="row g-4 align-items-center justify-content-center">
        <div class="col-6 col-md-3">
          <div class="stat-box">
            <div class="stat-number"><%= (typeof stats !== 'undefined' && stats && stats.totalItems) ? stats.totalItems : 0 %>+</div>
            <div class="stat-label">Items Logged</div>
          </div>
        </div>
        <div class="col-6 col-md-3">
          <div class="stat-box">
            <div class="stat-number" style="color: var(--accent-lime);"><%= (typeof stats !== 'undefined' && stats && stats.returnedItems) ? stats.returnedItems : 0 %></div>
            <div class="stat-label">Reunited Owners</div>
          </div>
        </div>
        <div class="col-6 col-md-3">
          <div class="stat-box">
            <div class="stat-number"><%= (typeof stats !== 'undefined' && stats && stats.activeClaims) ? stats.activeClaims : 0 %></div>
            <div class="stat-label">Active Claims</div>
          </div>
        </div>
        <div class="col-6 col-md-3">
          <div class="stat-box">
            <div class="stat-number" style="color: var(--accent-cyan);">94%</div>
            <div class="stat-label">Success Rate</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       BROWSE BY CATEGORY
       ========================================================================= -->
  <section class="py-5">
    <div class="container">
      <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end mb-4">
        <div>
          <span class="small fw-bold text-uppercase" style="color: var(--accent-lime); letter-spacing: 0.08em;">Categories</span>
          <h2 class="h3 fw-bold text-white mb-1">Browse by Belonging Type</h2>
          <p class="text-muted small mb-0">Quickly filter catalog by university gear classification</p>
        </div>
        <a href="/items" class="btn-pill-ghost btn-sm mt-3 mt-md-0">
          <span>View All Categories</span>
          <span class="arrow-chip" style="width: 18px; height: 18px; font-size: 0.65rem;">&rarr;</span>
        </a>
      </div>

      <div class="row g-3">
        <% const categoriesList = [
          { key: 'electronics', name: 'Electronics', icon: 'bi-laptop', count: 18 },
          { key: 'id_cards', name: 'Student IDs & Cards', icon: 'bi-person-badge', count: 24 },
          { key: 'keys_wallets', name: 'Keys & Wallets', icon: 'bi-key', count: 15 },
          { key: 'bags_backpacks', name: 'Bags & Backpacks', icon: 'bi-backpack', count: 9 },
          { key: 'books_notes', name: 'Books & Notes', icon: 'bi-journal-code', count: 12 },
          { key: 'clothing', name: 'Clothing & Jackets', icon: 'bi-sunglasses', count: 8 }
        ]; %>

        <% categoriesList.forEach(cat => { %>
          <div class="col-6 col-md-4 col-lg-2">
            <a href="/items?category=<%= cat.key %>" class="category-bubble-card">
              <div class="category-bubble-icon">
                <i class="bi <%= cat.icon %>"></i>
              </div>
              <div class="category-bubble-name"><%= cat.name %></div>
              <div class="category-bubble-count"><%= cat.count %> listed</div>
            </a>
          </div>
        <% }); %>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       RECENT LOST & FOUND REPORTS
       ========================================================================= -->
  <section class="py-5" style="background: rgba(14, 14, 14, 0.6); border-top: 1px solid var(--border-subtle); border-bottom: 1px solid var(--border-subtle);">
    <div class="container">
      <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
          <span class="small fw-bold text-uppercase" style="color: var(--accent-cyan); letter-spacing: 0.08em;">Live Feed</span>
          <h2 class="h3 fw-bold text-white mb-1">Recent Campus Reports</h2>
          <p class="text-muted small mb-0">Real-time submissions from students and campus security</p>
        </div>

        <div class="d-flex gap-2">
          <a href="/items?type=lost" class="btn btn-sm rounded-pill px-3" style="background: rgba(255,90,112,0.15); color: #ff5a70; border: 1px solid rgba(255,90,112,0.3); font-weight: 600;">
            <i class="bi bi-search me-1"></i> Lost (<%= (typeof stats !== 'undefined' && stats && stats.lostCount) ? stats.lostCount : 0 %>)
          </a>
          <a href="/items?type=found" class="btn btn-sm rounded-pill px-3" style="background: rgba(94,228,117,0.15); color: #5ee475; border: 1px solid rgba(94,228,117,0.3); font-weight: 600;">
            <i class="bi bi-check-circle me-1"></i> Found (<%= (typeof stats !== 'undefined' && stats && stats.foundCount) ? stats.foundCount : 0 %>)
          </a>
        </div>
      </div>

      <div class="row g-4">
        <% if (recentItems && recentItems.length > 0) { %>
          <% recentItems.forEach(item => { %>
            <%- include('../partials/item-card', { item: item }) %>
          <% }); %>
        <% } else { %>
          <div class="col-12">
            <div class="text-center py-5 p-4 rounded-4" style="background: var(--bg-surface); border: 1px dashed var(--border-medium);">
              <i class="bi bi-inbox display-4 text-muted mb-3 d-block"></i>
              <h4 class="text-white fw-bold">No items reported yet</h4>
              <p class="text-muted small">Be the first to log a found or missing item in your student community.</p>
              <a href="/items/report" class="btn-pill-white mt-2">Submit a Report</a>
            </div>
          </div>
        <% } %>
      </div>

      <div class="text-center mt-5">
        <a href="/items" class="btn-pill-ghost px-5 py-2">
          <span>Explore All <%= (typeof stats !== 'undefined' && stats && stats.totalItems) ? stats.totalItems : 0 %> Items in Directory</span>
          <span class="arrow-chip">&rarr;</span>
        </a>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       HOW IT WORKS SECTION
       ========================================================================= -->
  <section class="py-5" id="howItWorks">
    <div class="container py-4">
      <div class="text-center mb-5">
        <span class="small fw-bold text-uppercase" style="color: var(--accent-lime); letter-spacing: 0.08em;">Workflow</span>
        <h2 class="h2 fw-bold text-white mb-2">How Campus Recovery Works</h2>
        <p class="text-muted mx-auto" style="max-width: 540px;">
          Designed for maximum student safety and rapid reunions with verifiable security safeguards.
        </p>
      </div>

      <div class="row g-4 text-center">
        <div class="col-md-4">
          <div class="p-4 rounded-4 h-100" style="background: var(--bg-surface); border: 1px solid var(--border-subtle); transition: var(--transition-smooth);">
            <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 58px; height: 58px; background: rgba(230,242,107,0.12); color: var(--accent-lime); font-size: 1.4rem; font-weight: 800; border: 1px solid rgba(230,242,107,0.3);">
              1
            </div>
            <h4 class="h5 fw-bold text-white mb-2">Report &amp; Search</h4>
            <p class="text-muted small mb-0">
              Post photos and distinguishing traits. Instant duplicate detection cross-checks across all active faculty logs automatically.
            </p>
          </div>
        </div>

        <div class="col-md-4">
          <div class="p-4 rounded-4 h-100" style="background: var(--bg-surface); border: 1px solid var(--border-subtle); transition: var(--transition-smooth);">
            <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 58px; height: 58px; background: rgba(25,181,232,0.12); color: var(--accent-cyan); font-size: 1.4rem; font-weight: 800; border: 1px solid rgba(25,181,232,0.3);">
              2
            </div>
            <h4 class="h5 fw-bold text-white mb-2">Verify &amp; Claim</h4>
            <p class="text-muted small mb-0">
              Submit proof of ownership &mdash; such as unique markings, lock screen patterns, or serial numbers &mdash; to prevent unauthorized handovers.
            </p>
          </div>
        </div>

        <div class="col-md-4">
          <div class="p-4 rounded-4 h-100" style="background: var(--bg-surface); border: 1px solid var(--border-subtle); transition: var(--transition-smooth);">
            <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 58px; height: 58px; background: rgba(94,228,117,0.12); color: var(--accent-green); font-size: 1.4rem; font-weight: 800; border: 1px solid rgba(94,228,117,0.3);">
              3
            </div>
            <h4 class="h5 fw-bold text-white mb-2">Collect Safely</h4>
            <p class="text-muted small mb-0">
              Once verified by campus security, collect your belongings with your student ID at the Central Security Dispatch Desk.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       CAMPUS CUSTODY & PHYSICAL RETRIEVAL VAULT
       ========================================================================= -->
  <section class="py-5">
    <div class="container">
      <div class="p-4 p-md-5 rounded-4 position-relative overflow-hidden" style="background: linear-gradient(135deg, #161616 0%, #1e1e1e 100%); border: 1px solid rgba(255,255,255,0.12); box-shadow: var(--shadow-card);">
        <div class="row align-items-center">
          <div class="col-lg-8">
            <span class="badge rounded-pill px-3 py-2 fw-bold mb-3" style="background: rgba(230,242,107,0.15); color: var(--accent-lime); border: 1px solid rgba(230,242,107,0.3);">
              Physical Campus Custody
            </span>
            <h2 class="h3 fw-bold text-white mb-2">Student Center Central Retrieval Desk</h2>
            <p class="text-muted mb-4" style="max-width: 620px;">
              All high-value items (wallets, laptops, phones, student ID cards) reported as found are securely held in the Central Security Vault at the Student Center.
            </p>
            <div class="d-flex flex-wrap gap-4 small text-muted">
              <div><i class="bi bi-geo-alt-fill me-2" style="color: var(--accent-pink);"></i> Student Center, Room 102</div>
              <div><i class="bi bi-clock-fill me-2" style="color: var(--accent-cyan);"></i> Mon-Fri 8:00 AM &ndash; 6:00 PM</div>
              <div><i class="bi bi-shield-check me-2" style="color: var(--accent-lime);"></i> Student ID required</div>
            </div>
          </div>
          <div class="col-lg-4 text-lg-end mt-4 mt-lg-0">
            <a href="/items/report?type=found" class="btn-pill-white px-4 py-2">
              <span>Hand In Belonging</span>
              <span class="arrow-chip">&nearr;</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</main>

<%- include('../partials/claim-modal') %>
<%- include('../partials/footer') %>
