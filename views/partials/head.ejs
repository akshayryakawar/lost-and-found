<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Campus Lost & Found | Official University Portal' %></title>
  
  <!-- Favicon / Meta -->
  <meta name="description" content="A modern campus space where lost belongings find their way home — report, track, and claim items in seconds.">
  <meta name="theme-color" content="#080808">

  <!-- Google Fonts: Inter Tight (modern grotesk) + Instrument Serif (editorial italic swash) + Plus Jakarta Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter+Tight:ital,wght@0,400;0,500;0,600;0,700;0,800;1,600;1,700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <!-- Bootstrap 5.3.3 CSS (no SRI — avoids browser shield blocking) -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous">

  <!-- Bootstrap Icons -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

  <!-- Custom Design System (v2.3 — cache bust) -->
  <link rel="stylesheet" href="/css/style.css?v=2.4">
</head>
<body class="theme-dark-body">
