<%- include('../../partials/head', { title: 'Register Account | Campus Lost & Found' }) %>
<%- include('../../partials/navbar', { activePage: 'register' }) %>

<main class="py-5 position-relative">
  <!-- Subtle ambient glow behind register card -->
  <div class="ambient-glow-wrapper">
    <div class="ambient-glow-center" style="width: 550px; height: 550px; opacity: 0.8;"></div>
  </div>

  <div class="container position-relative" style="max-width: 520px; z-index: 5;">
    <%- include('../../partials/alerts') %>

    <div class="p-4 p-md-5 rounded-4" style="background: var(--bg-surface); border: 1px solid var(--border-medium); box-shadow: var(--shadow-card); backdrop-filter: blur(12px);">
      <div class="text-center mb-4">
        <span class="asterisk-mark mb-2" style="font-size: 2.2rem;">&#10033;</span>
        <h2 class="h3 fw-bold text-white mb-1">Create Student Account</h2>
        <p class="text-muted small">Register to track reports, receive return alerts, and submit claims</p>
      </div>

      <form action="/auth/register" method="POST" id="registerForm" class="needs-validation" novalidate>
        <div class="mb-3">
          <label for="regName" class="form-label text-white">Full Name <span style="color: var(--lost-color);">*</span></label>
          <div class="input-group">
            <span class="input-group-text border-end-0 text-muted"><i class="bi bi-person"></i></span>
            <input type="text" class="form-control border-start-0 ps-0" id="regName" name="name" placeholder="Alex Chen" required>
          </div>
        </div>

        <div class="mb-3">
          <label for="regEmail" class="form-label text-white">University Email <span style="color: var(--lost-color);">*</span></label>
          <div class="input-group">
            <span class="input-group-text border-end-0 text-muted"><i class="bi bi-envelope"></i></span>
            <input type="email" class="form-control border-start-0 ps-0" id="regEmail" name="email" placeholder="alex.chen@university.edu" required>
          </div>
          <div class="small text-muted mt-1" style="font-size: 0.76rem;">Please use your valid university student or staff email address.</div>
        </div>

        <div class="row g-2 mb-3">
          <div class="col-md-6">
            <label for="regPassword" class="form-label text-white">Password <span style="color: var(--lost-color);">*</span></label>
            <div class="input-group">
              <span class="input-group-text border-end-0 text-muted"><i class="bi bi-lock"></i></span>
              <input type="password" class="form-control border-start-0 ps-0" id="regPassword" name="password" placeholder="At least 6 chars" minlength="6" required>
            </div>
          </div>
          <div class="col-md-6">
            <label for="regConfirmPassword" class="form-label text-white">Confirm <span style="color: var(--lost-color);">*</span></label>
            <div class="input-group">
              <span class="input-group-text border-end-0 text-muted"><i class="bi bi-lock-fill"></i></span>
              <input type="password" class="form-control border-start-0 ps-0" id="regConfirmPassword" name="confirmPassword" placeholder="Repeat password" minlength="6" required>
            </div>
          </div>
        </div>

        <div class="mb-4 form-check">
          <input type="checkbox" class="form-check-input" id="termsCheck" required style="background-color: #1a1a1a; border-color: rgba(255,255,255,0.2);">
          <label class="form-check-label small text-muted" for="termsCheck">
            I agree to the <a href="#" class="text-white text-decoration-none">Campus Lost &amp; Found Honor Code</a> and terms of service.
          </label>
        </div>

        <button type="submit" class="btn-pill-white w-100 justify-content-center py-2 mb-3">
          <span>Create Account</span>
          <span class="arrow-chip">&nearr;</span>
        </button>

        <div class="text-center small text-muted">
          Already registered? 
          <a href="/auth/login" class="fw-bold text-white text-decoration-none ms-1">Sign In</a>
        </div>
      </form>
    </div>
  </div>
</main>

<%- include('../../partials/footer') %>
