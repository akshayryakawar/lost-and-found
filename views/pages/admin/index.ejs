<%- include('../../partials/head', { title: 'Admin Moderation Portal | Campus Lost & Found' }) %>
<%- include('../../partials/navbar', { activePage: 'admin' }) %>

<main class="py-4">
  <div class="container-fluid px-lg-5">
    <%- include('../../partials/alerts') %>

    <!-- Admin Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
      <div>
        <div class="badge rounded-pill px-3 py-2 fw-bold mb-1" style="background: rgba(255,90,112,0.15); color: #ff5a70; border: 1px solid rgba(255,90,112,0.3);">
          <i class="bi bi-shield-lock-fill me-1"></i> Campus Administration &amp; Security
        </div>
        <h1 class="h3 fw-bold text-white mb-0">Management &amp; Dispatch Console</h1>
      </div>

      <div class="d-flex gap-2">
        <a href="/items/report" class="btn-pill-white btn-sm px-3">
          <span>Log Found Item</span>
          <span class="arrow-chip" style="width: 18px; height: 18px; font-size: 0.65rem;">&nearr;</span>
        </a>
      </div>
    </div>

    <!-- Admin KPI Cards -->
    <div class="row g-3 mb-4">
      <div class="col-xl-3 col-md-6">
        <div class="dashboard-stat-card">
          <div class="stat-icon-wrap stat-icon-blue">
            <i class="bi bi-box-seam"></i>
          </div>
          <div>
            <div class="text-muted small fw-semibold">Total Inventory</div>
            <h3 class="fw-bold mb-0 text-white"><%= adminStats.totalItems %></h3>
          </div>
        </div>
      </div>

      <div class="col-xl-3 col-md-6">
        <div class="dashboard-stat-card">
          <div class="stat-icon-wrap stat-icon-amber">
            <i class="bi bi-hourglass-top"></i>
          </div>
          <div>
            <div class="text-muted small fw-semibold">Pending Claims</div>
            <h3 class="fw-bold mb-0" style="color: var(--accent-amber);"><%= adminStats.pendingClaims %></h3>
          </div>
        </div>
      </div>

      <div class="col-xl-3 col-md-6">
        <div class="dashboard-stat-card">
          <div class="stat-icon-wrap stat-icon-rose">
            <i class="bi bi-search"></i>
          </div>
          <div>
            <div class="text-muted small fw-semibold">Active Lost Reports</div>
            <h3 class="fw-bold mb-0" style="color: var(--lost-color);"><%= adminStats.openLost %></h3>
          </div>
        </div>
      </div>

      <div class="col-xl-3 col-md-6">
        <div class="dashboard-stat-card">
          <div class="stat-icon-wrap stat-icon-green">
            <i class="bi bi-check2-all"></i>
          </div>
          <div>
            <div class="text-muted small fw-semibold">Returned to Owners</div>
            <h3 class="fw-bold mb-0" style="color: var(--accent-lime);"><%= adminStats.returnedItems %></h3>
          </div>
        </div>
      </div>
    </div>

    <!-- Admin Main Tabs -->
    <div class="rounded-4 overflow-hidden" style="background: var(--bg-surface); border: 1px solid var(--border-subtle); box-shadow: var(--shadow-card);">
      <div class="border-bottom p-3" style="border-color: var(--border-subtle) !important; background: #151515;">
        <ul class="nav gap-2" id="adminTab" role="tablist">
          <li class="nav-item" role="presentation">
            <button class="btn btn-pill-white btn-sm active" id="claims-tab" data-bs-toggle="tab" data-bs-target="#admin-claims-pane" type="button" role="tab" aria-controls="admin-claims-pane" aria-selected="true">
              <i class="bi bi-shield-check me-1"></i> Claims Moderation Queue (<%= claims.filter(c => c.status === 'pending').length %>)
            </button>
          </li>
          <li class="nav-item" role="presentation">
            <button class="btn btn-pill-ghost btn-sm" id="inventory-tab" data-bs-toggle="tab" data-bs-target="#admin-inventory-pane" type="button" role="tab" aria-controls="admin-inventory-pane" aria-selected="false">
              <i class="bi bi-boxes me-1"></i> All Reported Items (<%= items.length %>)
            </button>
          </li>
          <li class="nav-item" role="presentation">
            <button class="btn btn-pill-ghost btn-sm" id="users-tab" data-bs-toggle="tab" data-bs-target="#admin-users-pane" type="button" role="tab" aria-controls="admin-users-pane" aria-selected="false">
              <i class="bi bi-people me-1"></i> User Accounts (<%= users.length %>)
            </button>
          </li>
        </ul>
      </div>

      <div class="p-4">
        <div class="tab-content" id="adminTabContent">
          <!-- Pane 1: Claims Moderation Queue -->
          <div class="tab-pane fade show active" id="admin-claims-pane" role="tabpanel" aria-labelledby="claims-tab">
            <div class="d-flex justify-content-between align-items-center mb-3">
              <h5 class="fw-bold text-white mb-0">Ownership Claims Needing Verification</h5>
              <small class="text-muted">Compare claimant proof against secret details in inventory.</small>
            </div>

            <div class="table-responsive">
              <table class="table table-custom align-middle">
                <thead>
                  <tr>
                    <th>Claimed Item</th>
                    <th>Claimant Info</th>
                    <th>Proof Provided</th>
                    <th>Date Filed</th>
                    <th>Status</th>
                    <th class="text-end">Moderation Action</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (claims && claims.length > 0) { %>
                    <% claims.forEach(claim => { %>
                      <tr>
                        <td>
                          <div class="fw-bold text-white"><%= claim.item ? claim.item.title : 'Item #' + claim.itemId %></div>
                          <a href="/items/<%= claim.itemId %>" class="small text-decoration-none" style="color: var(--accent-cyan);" target="_blank">
                            <i class="bi bi-box-arrow-up-right me-1"></i> View Item
                          </a>
                        </td>
                        <td>
                          <div class="fw-bold text-white"><%= claim.claimedBy ? claim.claimedBy.name : 'Unknown User' %></div>
                          <div class="small text-muted"><%= claim.claimedBy ? claim.claimedBy.email : '' %></div>
                        </td>
                        <td>
                          <div class="p-2 rounded-3 small text-muted" style="max-width: 320px; white-space: normal; background: #1a1a1a; border: 1px solid var(--border-subtle);">
                            <strong class="text-white">Proof:</strong> <%= claim.proofDescription %><br>
                            <% if (claim.message) { %>
                              <span class="text-muted"><strong>Note:</strong> <%= claim.message %></span>
                            <% } %>
                          </div>
                        </td>
                        <td>
                          <small class="text-muted"><%= new Date(claim.createdAt).toLocaleDateString() %></small>
                        </td>
                        <td>
                          <% if (claim.status === 'pending') { %>
                            <span class="badge rounded-pill px-3 py-1" style="background: var(--review-bg); color: var(--review-color); border: 1px solid var(--review-border);">Pending</span>
                          <% } else if (claim.status === 'approved') { %>
                            <span class="badge rounded-pill px-3 py-1" style="background: var(--found-bg); color: var(--found-color); border: 1px solid var(--found-border);">Approved</span>
                          <% } else { %>
                            <span class="badge rounded-pill px-3 py-1" style="background: var(--lost-bg); color: var(--lost-color); border: 1px solid var(--lost-border);">Rejected</span>
                          <% } %>
                        </td>
                        <td class="text-end">
                          <% if (claim.status === 'pending') { %>
                            <div class="d-flex justify-content-end gap-2">
                              <form action="/admin/claims/<%= claim.id || claim._id %>/approve" method="POST" class="d-inline">
                                <button type="submit" class="btn btn-sm rounded-pill px-3" style="background: var(--accent-green); color: #000; font-weight: 600;" onclick="return confirm('Approve this claim? Item will be marked under review/ready for collection.')">
                                  <i class="bi bi-check-lg"></i> Approve
                                </button>
                              </form>
                              <form action="/admin/claims/<%= claim.id || claim._id %>/reject" method="POST" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3" onclick="return confirm('Reject this claim?')">
                                  <i class="bi bi-x-lg"></i> Reject
                                </button>
                              </form>
                            </div>
                          <% } else { %>
                            <span class="text-muted small">Decided</span>
                          <% } %>
                        </td>
                      </tr>
                    <% }); %>
                  <% } else { %>
                    <tr>
                      <td colspan="6" class="text-center py-4 text-muted">No pending claims found.</td>
                    </tr>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>

          <!-- Pane 2: Inventory Items Management -->
          <div class="tab-pane fade" id="admin-inventory-pane" role="tabpanel" aria-labelledby="inventory-tab">
            <div class="d-flex justify-content-between align-items-center mb-3">
              <h5 class="fw-bold text-white mb-0">Master Item Directory</h5>
              <small class="text-muted">Update status or mark items as safely returned.</small>
            </div>

            <div class="table-responsive">
              <table class="table table-custom align-middle">
                <thead>
                  <tr>
                    <th>Item</th>
                    <th>Type</th>
                    <th>Location</th>
                    <th>Reported By</th>
                    <th>Current Status</th>
                    <th class="text-end">Update Status</th>
                  </tr>
                </thead>
                <tbody>
                  <% items.forEach(item => { %>
                    <tr>
                      <td>
                        <div class="d-flex align-items-center gap-2">
                          <% if (item.imageUrl || item.image_url) { %>
                            <img src="<%= item.imageUrl || item.image_url %>" class="rounded-2" style="width: 38px; height: 38px; object-fit: cover;" alt="">
                          <% } %>
                          <div>
                            <div class="fw-bold"><a href="/items/<%= item.id || item._id %>" class="text-white text-decoration-none"><%= item.title %></a></div>
                            <small class="text-muted"><%= (item.category || '').replace(/_/g, ' ') %></small>
                          </div>
                        </div>
                      </td>
                      <td>
                        <span class="badge rounded-pill px-3 py-1" style="background: <%= item.type === 'lost' ? 'var(--lost-bg)' : 'var(--found-bg)' %>; color: <%= item.type === 'lost' ? 'var(--lost-color)' : 'var(--found-color)' %>; border: 1px solid <%= item.type === 'lost' ? 'var(--lost-border)' : 'var(--found-border)' %>;">
                          <%= item.type.toUpperCase() %>
                        </span>
                      </td>
                      <td><small><i class="bi bi-geo-alt me-1" style="color: var(--accent-pink);"></i><%= item.location %></small></td>
                      <td><small class="text-muted"><%= item.reportedBy ? item.reportedBy.name : 'Unknown' %></small></td>
                      <td>
                        <span class="badge badge-status status-<%= item.status %>">
                          <%= item.status.replace('_', ' ').toUpperCase() %>
                        </span>
                      </td>
                      <td class="text-end">
                        <form action="/admin/items/<%= item.id || item._id %>/status" method="POST" class="d-inline-flex gap-2 align-items-center justify-content-end">
                          <select name="status" class="form-select form-select-sm" style="width: 140px;">
                            <option value="open" <%= item.status === 'open' ? 'selected' : '' %>>Open</option>
                            <option value="under_review" <%= item.status === 'under_review' ? 'selected' : '' %>>Under Review</option>
                            <option value="claimed" <%= item.status === 'claimed' ? 'selected' : '' %>>Claimed</option>
                            <option value="returned" <%= item.status === 'returned' ? 'selected' : '' %>>Returned</option>
                          </select>
                          <button type="submit" class="btn-pill-white btn-sm px-3">
                            Save
                          </button>
                        </form>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          </div>

          <!-- Pane 3: User Accounts -->
          <div class="tab-pane fade" id="admin-users-pane" role="tabpanel" aria-labelledby="users-tab">
            <h5 class="fw-bold text-white mb-3">Registered Campus Users</h5>
            <div class="table-responsive">
              <table class="table table-custom align-middle">
                <thead>
                  <tr>
                    <th>User</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Registered Date</th>
                  </tr>
                </thead>
                <tbody>
                  <% users.forEach(u => { %>
                    <tr>
                      <td class="fw-bold text-white">
                        <i class="bi bi-person-circle me-2" style="color: var(--accent-cyan);"></i><%= u.name %>
                      </td>
                      <td class="text-muted"><%= u.email %></td>
                      <td>
                        <span class="badge rounded-pill px-3 py-1" style="background: <%= u.role === 'admin' ? 'rgba(255,90,112,0.15)' : 'rgba(230,242,107,0.15)' %>; color: <%= u.role === 'admin' ? '#ff5a70' : '#e6f26b' %>; border: 1px solid <%= u.role === 'admin' ? 'rgba(255,90,112,0.3)' : 'rgba(230,242,107,0.3)' %>;">
                          <%= u.role.toUpperCase() %>
                        </span>
                      </td>
                      <td><small class="text-muted"><%= new Date(u.createdAt).toLocaleDateString() %></small></td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</main>

<%- include('../../partials/footer') %>
