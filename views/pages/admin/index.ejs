<%- include('../../partials/head', { title: 'Admin Moderation Portal | Campus Lost & Found' }) %>
<%- include('../../partials/navbar', { activePage: 'admin' }) %>

<main class="py-4">
  <div class="container-fluid px-lg-5">
    <%- include('../../partials/alerts') %>

    <!-- Admin Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
      <div>
        <div class="badge bg-danger-subtle text-danger px-3 py-2 rounded-pill fw-bold mb-1">
          <i class="bi bi-shield-lock-fill me-1"></i> Campus Administration &amp; Security
        </div>
        <h1 class="h3 fw-bold text-white mb-0">Management &amp; Dispatch Console</h1>
      </div>

      <div class="d-flex gap-2">
        <a href="/items/report" class="btn btn-primary btn-sm rounded-pill px-3 fw-semibold">
          <i class="bi bi-plus-circle me-1"></i> Log Found Item to Custody
        </a>
      </div>
    </div>

    <!-- Admin KPI Cards -->
    <div class="row g-3 mb-4">
      <div class="col-xl-3 col-md-6">
        <div class="dashboard-stat-card">
          <div class="stat-icon-wrap stat-icon-blue">
            <i class="bi bi-box-seam"></i>
          </div>
          <div>
            <div class="text-muted small fw-semibold">Total Inventory</div>
            <h3 class="fw-bold mb-0"><%= adminStats.totalItems %></h3>
          </div>
        </div>
      </div>

      <div class="col-xl-3 col-md-6">
        <div class="dashboard-stat-card">
          <div class="stat-icon-wrap stat-icon-amber">
            <i class="bi bi-hourglass-top"></i>
          </div>
          <div>
            <div class="text-muted small fw-semibold">Pending Claims</div>
            <h3 class="fw-bold mb-0 text-warning"><%= adminStats.pendingClaims %></h3>
          </div>
        </div>
      </div>

      <div class="col-xl-3 col-md-6">
        <div class="dashboard-stat-card">
          <div class="stat-icon-wrap stat-icon-rose">
            <i class="bi bi-search"></i>
          </div>
          <div>
            <div class="text-muted small fw-semibold">Active Lost Reports</div>
            <h3 class="fw-bold mb-0 text-danger"><%= adminStats.openLost %></h3>
          </div>
        </div>
      </div>

      <div class="col-xl-3 col-md-6">
        <div class="dashboard-stat-card">
          <div class="stat-icon-wrap stat-icon-green">
            <i class="bi bi-check2-all"></i>
          </div>
          <div>
            <div class="text-muted small fw-semibold">Returned to Owners</div>
            <h3 class="fw-bold mb-0 text-success"><%= adminStats.returnedItems %></h3>
          </div>
        </div>
      </div>
    </div>

    <!-- Admin Main Tabs -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
      <div class="card-header bg-card-dark border-bottom p-0">
        <ul class="nav nav-tabs border-0 px-3 pt-2" id="adminTab" role="tablist">
          <li class="nav-item" role="presentation">
            <button class="nav-link active fw-bold py-3 px-4 border-0 border-bottom border-danger border-3" id="claims-tab" data-bs-toggle="tab" data-bs-target="#admin-claims-pane" type="button" role="tab" aria-controls="admin-claims-pane" aria-selected="true">
              <i class="bi bi-shield-check me-2 text-warning"></i> Claims Moderation Queue (<%= claims.filter(c => c.status === 'pending').length %>)
            </button>
          </li>
          <li class="nav-item" role="presentation">
            <button class="nav-link fw-bold py-3 px-4 border-0" id="inventory-tab" data-bs-toggle="tab" data-bs-target="#admin-inventory-pane" type="button" role="tab" aria-controls="admin-inventory-pane" aria-selected="false">
              <i class="bi bi-boxes me-2 text-primary"></i> All Reported Items (<%= items.length %>)
            </button>
          </li>
          <li class="nav-item" role="presentation">
            <button class="nav-link fw-bold py-3 px-4 border-0" id="users-tab" data-bs-toggle="tab" data-bs-target="#admin-users-pane" type="button" role="tab" aria-controls="admin-users-pane" aria-selected="false">
              <i class="bi bi-people me-2 text-secondary"></i> User Accounts (<%= users.length %>)
            </button>
          </li>
        </ul>
      </div>

      <div class="card-body p-4">
        <div class="tab-content" id="adminTabContent">
          <!-- Pane 1: Claims Moderation Queue -->
          <div class="tab-pane fade show active" id="admin-claims-pane" role="tabpanel" aria-labelledby="claims-tab">
            <div class="d-flex justify-content-between align-items-center mb-3">
              <h5 class="fw-bold mb-0">Ownership Claims Needing Verification</h5>
              <small class="text-muted">Compare claimant proof against secret details in inventory.</small>
            </div>

            <div class="table-responsive">
              <table class="table table-custom align-middle">
                <thead>
                  <tr>
                    <th>Claimed Item</th>
                    <th>Claimant Info</th>
                    <th>Proof Provided</th>
                    <th>Date Filed</th>
                    <th>Status</th>
                    <th class="text-end">Moderation Action</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (claims && claims.length > 0) { %>
                    <% claims.forEach(claim => { %>
                      <tr>
                        <td>
                          <div class="fw-bold text-white"><%= claim.item ? claim.item.title : 'Item #' + claim.itemId %></div>
                          <a href="/items/<%= claim.itemId %>" class="small text-primary text-decoration-none" target="_blank">
                            <i class="bi bi-box-arrow-up-right me-1"></i> View Item
                          </a>
                        </td>
                        <td>
                          <div class="fw-bold text-white"><%= claim.claimedBy ? claim.claimedBy.name : 'Unknown User' %></div>
                          <div class="small text-muted"><%= claim.claimedBy ? claim.claimedBy.email : '' %></div>
                        </td>
                        <td>
                          <div class="p-2 bg-dark-alt rounded-3 small text-secondary" style="max-width: 320px; white-space: normal;">
                            <strong>Proof:</strong> <%= claim.proofDescription %><br>
                            <% if (claim.message) { %>
                              <span class="text-muted"><strong>Note:</strong> <%= claim.message %></span>
                            <% } %>
                          </div>
                        </td>
                        <td>
                          <small class="text-muted"><%= new Date(claim.createdAt).toLocaleDateString() %></small>
                        </td>
                        <td>
                          <% if (claim.status === 'pending') { %>
                            <span class="badge bg-warning-subtle text-warning border px-2 py-1">Pending</span>
                          <% } else if (claim.status === 'approved') { %>
                            <span class="badge bg-success-subtle text-success border px-2 py-1">Approved</span>
                          <% } else { %>
                            <span class="badge bg-danger-subtle text-danger border px-2 py-1">Rejected</span>
                          <% } %>
                        </td>
                        <td class="text-end">
                          <% if (claim.status === 'pending') { %>
                            <div class="d-flex justify-content-end gap-2">
                              <form action="/admin/claims/<%= claim._id %>/approve" method="POST" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-success rounded-pill px-3" onclick="return confirm('Approve this claim? Item will be marked under review/ready for collection.')">
                                  <i class="bi bi-check-lg"></i> Approve
                                </button>
                              </form>
                              <form action="/admin/claims/<%= claim._id %>/reject" method="POST" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3" onclick="return confirm('Reject this claim?')">
                                  <i class="bi bi-x-lg"></i> Reject
                                </button>
                              </form>
                            </div>
                          <% } else { %>
                            <span class="text-muted small">Decided</span>
                          <% } %>
                        </td>
                      </tr>
                    <% }); %>
                  <% } else { %>
                    <tr>
                      <td colspan="6" class="text-center py-4 text-muted">No pending claims found.</td>
                    </tr>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>

          <!-- Pane 2: Inventory Items Management -->
          <div class="tab-pane fade" id="admin-inventory-pane" role="tabpanel" aria-labelledby="inventory-tab">
            <div class="d-flex justify-content-between align-items-center mb-3">
              <h5 class="fw-bold mb-0">Master Item Directory</h5>
              <small class="text-muted">Update status or mark items as safely returned.</small>
            </div>

            <div class="table-responsive">
              <table class="table table-custom align-middle">
                <thead>
                  <tr>
                    <th>Item</th>
                    <th>Type</th>
                    <th>Location</th>
                    <th>Reported By</th>
                    <th>Current Status</th>
                    <th class="text-end">Update Status</th>
                  </tr>
                </thead>
                <tbody>
                  <% items.forEach(item => { %>
                    <tr>
                      <td>
                        <div class="d-flex align-items-center gap-2">
                          <% if (item.imageUrl) { %>
                            <img src="<%= item.imageUrl %>" class="rounded-2" style="width: 38px; height: 38px; object-fit: cover;" alt="">
                          <% } %>
                          <div>
                            <div class="fw-bold"><a href="/items/<%= item._id %>" class="text-white text-decoration-none"><%= item.title %></a></div>
                            <small class="text-muted"><%= item.category.replace('_', ' ') %></small>
                          </div>
                        </div>
                      </td>
                      <td>
                        <span class="badge <%= item.type === 'lost' ? 'bg-danger-subtle text-danger' : 'bg-success-subtle text-success' %> px-2 py-1">
                          <%= item.type.toUpperCase() %>
                        </span>
                      </td>
                      <td><small><i class="bi bi-geo-alt text-danger me-1"></i><%= item.location %></small></td>
                      <td><small><%= item.reportedBy ? item.reportedBy.name : 'Unknown' %></small></td>
                      <td>
                        <span class="badge badge-status status-<%= item.status %>">
                          <%= item.status.replace('_', ' ').toUpperCase() %>
                        </span>
                      </td>
                      <td class="text-end">
                        <form action="/admin/items/<%= item._id %>/status" method="POST" class="d-inline-flex gap-2 align-items-center justify-content-end">
                          <select name="status" class="form-select form-select-sm" style="width: 140px;">
                            <option value="open" <%= item.status === 'open' ? 'selected' : '' %>>Open</option>
                            <option value="under_review" <%= item.status === 'under_review' ? 'selected' : '' %>>Under Review</option>
                            <option value="claimed" <%= item.status === 'claimed' ? 'selected' : '' %>>Claimed</option>
                            <option value="returned" <%= item.status === 'returned' ? 'selected' : '' %>>Returned</option>
                          </select>
                          <button type="submit" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                            Save
                          </button>
                        </form>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          </div>

          <!-- Pane 3: User Accounts -->
          <div class="tab-pane fade" id="admin-users-pane" role="tabpanel" aria-labelledby="users-tab">
            <h5 class="fw-bold mb-3">Registered Campus Users</h5>
            <div class="table-responsive">
              <table class="table table-custom align-middle">
                <thead>
                  <tr>
                    <th>User</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Registered Date</th>
                  </tr>
                </thead>
                <tbody>
                  <% users.forEach(u => { %>
                    <tr>
                      <td class="fw-bold text-white">
                        <i class="bi bi-person-circle text-primary me-2"></i><%= u.name %>
                      </td>
                      <td><%= u.email %></td>
                      <td>
                        <span class="badge <%= u.role === 'admin' ? 'bg-danger-subtle text-danger' : 'bg-primary-subtle text-primary' %> px-2 py-1">
                          <%= u.role.toUpperCase() %>
                        </span>
                      </td>
                      <td><small class="text-muted"><%= new Date(u.createdAt).toLocaleDateString() %></small></td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</main>

<%- include('../../partials/footer') %>
