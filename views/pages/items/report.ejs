<%- include('../../partials/head', { title: 'Report an Item | Campus Lost & Found' }) %>
<%- include('../../partials/navbar', { activePage: 'report' }) %>

<main class="py-4 position-relative">
  <div class="container" style="max-width: 820px;">
    <%- include('../../partials/alerts') %>

    <!-- Standard Inner Page Header -->
    <div class="page-header">
      <div class="page-eyebrow">
        <span class="eyebrow-icon">&#9679;</span>
        <span>Submit Official Report</span>
      </div>
      <h1 class="page-title">
        Register a <span class="hero-accent-serif">Belonging.</span>
      </h1>
      <p class="page-subtitle">
        Fill out descriptive details to initiate verified cross-matching across campus facilities.
      </p>
    </div>

    <!-- Live Duplicate Warning Alert (Hidden by default, triggered by JS) -->
    <div id="duplicateWarningAlert" class="duplicate-alert-banner d-none" role="alert">
      <i class="bi bi-exclamation-triangle-fill fs-3 text-warning"></i>
      <div>
        <div class="fw-bold">Similar Existing Report Detected!</div>
        <div class="small">
          We found a similar entry in our database: <strong id="duplicateMatchTitle" class="text-white">Item</strong>.
          Please check if your item has already been reported before submitting.
        </div>
      </div>
    </div>

    <!-- Glass Form Card -->
    <div class="glass-panel p-4 p-md-5">
      <form action="/items" method="POST" enctype="multipart/form-data" id="reportItemForm" class="needs-validation" novalidate>
        <!-- Segmented Type Selector -->
        <div class="mb-4 text-center">
          <label class="form-label d-block small text-uppercase fw-bold mb-2" style="color: var(--accent-lime); letter-spacing: 0.06em;">What are you reporting?</label>
          <div class="segmented-pill-group" role="group" aria-label="Item Type Selector">
            <input type="radio" class="btn-check" name="type" id="typeLost" value="lost" <%= (typeof selectedType !== 'undefined' && selectedType === 'found') ? '' : 'checked' %>>
            <label class="btn" for="typeLost">
              <i class="bi bi-search me-1 text-danger"></i> I Lost an Item
            </label>

            <input type="radio" class="btn-check" name="type" id="typeFound" value="found" <%= (typeof selectedType !== 'undefined' && selectedType === 'found') ? 'checked' : '' %>>
            <label class="btn" for="typeFound">
              <i class="bi bi-plus-circle me-1 text-success"></i> I Found an Item
            </label>
          </div>
        </div>

        <div class="row g-3">
          <!-- Item Title -->
          <div class="col-12">
            <label for="reportTitle" class="form-label text-white">
              Item Title / Name <span style="color: var(--lost-color);">*</span>
            </label>
            <input type="text" class="form-control form-control-lg fs-6" id="reportTitle" name="title" placeholder="e.g., Casio FX-991EX Calculator, Black Dell XPS 15, Leather Wallet" required>
            <div class="invalid-feedback">Please provide a descriptive item title.</div>
          </div>

          <!-- Category -->
          <div class="col-md-6">
            <label for="reportCategory" class="form-label text-white">
              Category <span style="color: var(--lost-color);">*</span>
            </label>
            <select class="form-select" id="reportCategory" name="category" required>
              <option value="" disabled selected>Select category...</option>
              <option value="electronics">Electronics (Phones, Laptops, Earbuds, Chargers)</option>
              <option value="id_cards">Student IDs, Bank Cards, Badges</option>
              <option value="keys_wallets">Keys, Wallets, Purses</option>
              <option value="bags_backpacks">Bags, Backpacks, Luggage</option>
              <option value="books_notes">Books, Notebooks, Courseware</option>
              <option value="clothing">Clothing, Jackets, Footwear</option>
              <option value="accessories">Watches, Jewelry, Glasses</option>
              <option value="sports">Sports &amp; Fitness Equipment</option>
              <option value="other">Other / Miscellaneous</option>
            </select>
            <div class="invalid-feedback">Please select a category.</div>
          </div>

          <!-- Campus Location -->
          <div class="col-md-6">
            <label for="reportLocation" class="form-label text-white">
              Campus Location <span style="color: var(--lost-color);">*</span>
            </label>
            <select class="form-select" id="reportLocation" name="location" required>
              <option value="" disabled selected>Select campus area...</option>
              <option value="Main Library">Main Campus Library (Floors 1-4)</option>
              <option value="Science Block">Science Block / Physics & Chem Labs</option>
              <option value="Engineering Quad">Engineering Complex (Quad A & B)</option>
              <option value="Central Cafeteria">Central Cafeteria & Food Court</option>
              <option value="Student Center">Student Activity Center / Union</option>
              <option value="Sports Complex">Sports Complex & Gymnasium</option>
              <option value="Dormitory Hall A">Dormitory / Student Residences</option>
              <option value="Other">Other / Unknown Campus Zone</option>
            </select>
            <div class="invalid-feedback">Please specify the location.</div>
          </div>

          <!-- Date Lost or Found -->
          <div class="col-md-6">
            <label for="reportDate" class="form-label text-white">
              Date Lost or Found <span style="color: var(--lost-color);">*</span>
            </label>
            <input type="date" class="form-control" id="reportDate" name="dateLostOrFound" required max="<%= new Date().toISOString().split('T')[0] %>">
            <div class="invalid-feedback">Please select a valid date.</div>
          </div>

          <!-- Description -->
          <div class="col-12">
            <label for="reportDescription" class="form-label text-white">
              Detailed Description <span style="color: var(--lost-color);">*</span>
            </label>
            <textarea class="form-control" id="reportDescription" name="description" rows="4" placeholder="Mention color, brand, recognizable stickers, unique engravings, contents, or circumstances..." required minlength="15"></textarea>
            <div class="small text-muted mt-1">Detailed descriptions increase match accuracy by over 80%.</div>
          </div>

          <!-- Image Upload Dropzone -->
          <div class="col-12">
            <label class="form-label text-white">Item Photograph (Optional)</label>
            <div class="upload-dropzone" id="uploadDropzone">
              <input type="file" id="itemImageInput" name="image" accept="image/png, image/jpeg, image/jpg, image/webp" class="d-none">
              <div class="upload-dropzone-content">
                <i class="bi bi-cloud-arrow-up display-5 text-muted mb-2 d-block"></i>
                <div class="fw-bold text-white">Click to select photo or drag and drop here</div>
                <div class="small text-muted mt-1">Supports PNG, JPG, WEBP (Max 5MB)</div>
              </div>
              <div class="upload-preview-container" id="uploadPreviewContainer">
                <img src="" alt="Item Preview" id="uploadPreviewImg" class="upload-preview-img">
                <button type="button" class="upload-remove-btn" id="uploadRemoveBtn" title="Remove image">
                  <i class="bi bi-x"></i>
                </button>
              </div>
            </div>
          </div>
        </div>

        <div class="d-flex justify-content-between align-items-center mt-5 pt-3" style="border-top: 1px solid var(--border-subtle);">
          <a href="/items" class="btn-pill-ghost">Cancel</a>
          <button type="submit" class="btn-pill-white px-4 py-2">
            <span>Submit Report</span>
            <span class="arrow-chip">&nearr;</span>
          </button>
        </div>
      </form>
    </div>
  </div>
</main>

<%- include('../../partials/footer') %>
