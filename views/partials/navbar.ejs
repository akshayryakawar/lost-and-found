<header class="sticky-top">
  <nav class="navbar navbar-expand-lg navbar-campus">
    <div class="container">
      <!-- Brand Logo -->
      <a class="navbar-brand navbar-brand-wrapper" href="/">
        <div class="brand-icon">
          <i class="bi bi-box-seam"></i>
        </div>
        <div class="d-flex flex-column">
          <span class="brand-title">Campus L&F</span>
          <span class="brand-subtitle">University Portal</span>
        </div>
      </a>

      <!-- Mobile Hamburger -->
      <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMainContent" aria-controls="navbarMainContent" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>

      <!-- Nav Links & Actions -->
      <div class="collapse navbar-collapse" id="navbarMainContent">
        <!-- Centered pill nav links -->
        <ul class="navbar-nav mx-auto mb-2 mb-lg-0 gap-1">
          <li class="nav-item">
            <a class="nav-link <%= typeof activePage !== 'undefined' && activePage === 'home' ? 'active' : '' %>" href="/">
              Home
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link <%= typeof activePage !== 'undefined' && activePage === 'items' && typeof activeType === 'undefined' ? 'active' : '' %>" href="/items">
              Browse All
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link <%= typeof activeType !== 'undefined' && activeType === 'lost' ? 'active' : '' %>" href="/items?type=lost">
              Lost Items
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link <%= typeof activeType !== 'undefined' && activeType === 'found' ? 'active' : '' %>" href="/items?type=found">
              Found Items
            </a>
          </li>
        </ul>

        <!-- Right action group -->
        <div class="d-flex align-items-center gap-2 flex-wrap">

          <% if (typeof currentUser !== 'undefined' && currentUser) { %>
            <!-- Notification Bell -->
            <a href="/notifications" class="notification-bell-btn text-decoration-none" title="Notifications">
              <i class="bi bi-bell"></i>
              <% if (typeof unreadCount !== 'undefined' && unreadCount > 0) { %>
                <span class="notification-badge"><%= unreadCount %></span>
              <% } %>
            </a>

            <!-- Report dropdown -->
            <div class="dropdown">
              <button class="btn nav-btn-report dropdown-toggle d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                <i class="bi bi-plus-circle"></i>
                <span>Report</span>
              </button>
              <ul class="dropdown-menu dropdown-menu-end shadow border-0 p-2">
                <li>
                  <a class="dropdown-item d-flex align-items-center gap-2 py-2 rounded" href="/items/report?type=lost">
                    <span style="width:28px;height:28px;border-radius:50%;background:rgba(248,113,113,.15);display:flex;align-items:center;justify-content:center;font-size:.8rem;color:#f87171;flex-shrink:0;"><i class="bi bi-search"></i></span>
                    <div>
                      <div class="fw-bold small" style="color:#fff;">I Lost Something</div>
                      <small>Report your missing property</small>
                    </div>
                  </a>
                </li>
                <li><hr class="dropdown-divider my-1"></li>
                <li>
                  <a class="dropdown-item d-flex align-items-center gap-2 py-2 rounded" href="/items/report?type=found">
                    <span style="width:28px;height:28px;border-radius:50%;background:rgba(52,211,153,.15);display:flex;align-items:center;justify-content:center;font-size:.8rem;color:#34d399;flex-shrink:0;"><i class="bi bi-hand-index-thumb"></i></span>
                    <div>
                      <div class="fw-bold small" style="color:#fff;">I Found Something</div>
                      <small>Help reunite an item with its owner</small>
                    </div>
                  </a>
                </li>
              </ul>
            </div>

            <!-- User avatar dropdown -->
            <div class="dropdown ms-1">
              <button class="btn d-flex align-items-center gap-2 py-1 px-3 dropdown-toggle shadow-none" type="button"
                data-bs-toggle="dropdown" aria-expanded="false"
                style="background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.12);border-radius:9999px;color:#fff;">
                <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width:26px;height:26px;font-size:.78rem;background:linear-gradient(135deg,#2dd4bf,#3b82f6);color:#0a0a0a;flex-shrink:0;">
                  <%= currentUser.name.charAt(0).toUpperCase() %>
                </div>
                <span class="fw-semibold small text-truncate" style="max-width:100px;color:#fff;"><%= currentUser.name.split(' ')[0] %></span>
              </button>
              <ul class="dropdown-menu dropdown-menu-end p-2" style="min-width:220px;">
                <li class="px-3 py-2 mb-1" style="border-bottom:1px solid rgba(255,255,255,.08);">
                  <div class="fw-bold small" style="color:#fff;"><%= currentUser.name %></div>
                  <div class="small text-truncate" style="color:rgba(255,255,255,.45);"><%= currentUser.email %></div>
                  <span class="badge mt-1 small" style="background:<%= currentUser.role === 'admin' ? 'rgba(248,113,113,.15)' : 'rgba(45,212,191,.15)' %>;color:<%= currentUser.role === 'admin' ? '#f87171' : '#2dd4bf' %>;border:1px solid <%= currentUser.role === 'admin' ? 'rgba(248,113,113,.25)' : 'rgba(45,212,191,.25)' %>;">
                    <%= currentUser.role === 'admin' ? 'Campus Admin' : 'Student' %>
                  </span>
                </li>
                <li><a class="dropdown-item py-2 rounded" href="/dashboard"><i class="bi bi-speedometer2 me-2" style="color:#3b82f6;"></i>My Dashboard</a></li>
                <li><a class="dropdown-item py-2 rounded" href="/dashboard#reports"><i class="bi bi-file-earmark-text me-2" style="color:rgba(255,255,255,.4);"></i>My Reports</a></li>
                <li><a class="dropdown-item py-2 rounded" href="/dashboard#claims"><i class="bi bi-patch-check me-2" style="color:#34d399;"></i>My Claims</a></li>
                <% if (currentUser.role === 'admin') { %>
                  <li><hr class="dropdown-divider my-1"></li>
                  <li><a class="dropdown-item py-2 rounded fw-semibold" href="/admin" style="color:#f87171;"><i class="bi bi-shield-check me-2"></i>Admin Panel</a></li>
                <% } %>
                <li><hr class="dropdown-divider my-1"></li>
                <li><a class="dropdown-item py-2 rounded" href="/auth/logout" style="color:#f87171;"><i class="bi bi-box-arrow-right me-2"></i>Sign Out</a></li>
              </ul>
            </div>

          <% } else { %>
            <!-- Guest: Report dropdown -->
            <div class="dropdown">
              <button class="btn nav-btn-report dropdown-toggle d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                <i class="bi bi-plus-circle"></i>
                <span>Report</span>
              </button>
              <ul class="dropdown-menu dropdown-menu-end shadow border-0 p-2">
                <li>
                  <a class="dropdown-item d-flex align-items-center gap-2 py-2 rounded" href="/items/report?type=lost">
                    <span style="width:28px;height:28px;border-radius:50%;background:rgba(248,113,113,.15);display:flex;align-items:center;justify-content:center;font-size:.8rem;color:#f87171;flex-shrink:0;"><i class="bi bi-search"></i></span>
                    <div>
                      <div class="fw-bold small" style="color:#fff;">I Lost Something</div>
                      <small>Report your missing property</small>
                    </div>
                  </a>
                </li>
                <li><hr class="dropdown-divider my-1"></li>
                <li>
                  <a class="dropdown-item d-flex align-items-center gap-2 py-2 rounded" href="/items/report?type=found">
                    <span style="width:28px;height:28px;border-radius:50%;background:rgba(52,211,153,.15);display:flex;align-items:center;justify-content:center;font-size:.8rem;color:#34d399;flex-shrink:0;"><i class="bi bi-hand-index-thumb"></i></span>
                    <div>
                      <div class="fw-bold small" style="color:#fff;">I Found Something</div>
                      <small>Help reunite an item with its owner</small>
                    </div>
                  </a>
                </li>
              </ul>
            </div>

            <!-- Login ghost link -->
            <a href="/auth/login" class="fw-semibold small" style="color:rgba(255,255,255,.6);transition:color .2s;" onmouseover="this.style.color='#fff'" onmouseout="this.style.color='rgba(255,255,255,.6)'">
              Sign In
            </a>
            <!-- Register CTA -->
            <a href="/auth/register" class="btn btn-sm rounded-pill fw-bold px-4" style="background:#fff;color:#0a0a0a;border:none;">
              Register
            </a>
          <% } %>
        </div>
      </div>
    </div>
  </nav>
</header>
